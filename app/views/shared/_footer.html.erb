<footer class="bg-music-surface text-music-text border-t border-music-surface py-8">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <h3 class="text-lg font-display mb-4 text-music-primary">Skenaria</h3>
        <p class="text-music-text-secondary">A platform for independent artists to share their music directly with fans.</p>
      </div>

      <div>
        <h4 class="font-bold mb-4 text-music-text">Explore</h4>
        <ul class="space-y-2">
          <li>
            <a href="/discover" class="text-music-text-secondary hover:text-music-primary transition-colors duration-200">Discover Music</a>
          </li>
          <li>
            <a href="/upload" class="text-music-text-secondary hover:text-music-primary transition-colors duration-200">Upload Your Music</a>
          </li>
        </ul>
      </div>

      <div>
        <h4 class="font-bold mb-4 text-music-text">Stay in Touch</h4>
        <p class="text-music-text-secondary">Subscribe to our newsletter</p>
        <div class="mt-2 flex">
          <input type="email" 
                 placeholder="Your email" 
                 class="px-3 py-2 bg-music-background border border-music-text-secondary text-music-text rounded-l-button focus:outline-none focus:border-music-primary focus:ring-1 focus:ring-music-primary">
          <button class="bg-music-primary text-music-text px-4 py-2 rounded-r-button hover:bg-opacity-90 transition-colors duration-200 shadow-button">
            Join
          </button>
        </div>
      </div>
    </div>

    <div class="border-t border-music-surface mt-8 pt-6 text-center text-music-text-secondary">
      <p>© <%= Time.current.year %> Skenaria. All rights reserved.</p>
    </div>
  </div>
</footer>
