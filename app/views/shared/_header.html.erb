<!-- Header -->
<header class="bg-music-background text-music-text border-b border-music-surface">
  <div class="container mx-auto px-4 py-3 flex justify-between items-center">
    <div class="flex items-center space-x-4">
      <%= link_to root_path, class: "text-2xl font-display text-music-primary" do %>
        Skenaria
      <% end %>
      <nav class="hidden md:flex space-x-6">
        <%= link_to "Music", music_path, class: "text-music-text hover:text-music-primary transition-colors" %>
        <%= link_to "Fans", fan_profiles_path, class: "text-music-text hover:text-music-primary transition-colors" %>
        <% if user_signed_in? && current_user.artist? %>
          <%= link_to "Dashboard", dashboard_path, class: "text-music-text hover:text-music-primary transition-colors" %>
          <%= link_to "My Artist Page", artist_profile_path(current_user.artist_profile), class: "text-music-text hover:text-music-primary transition-colors" %>
        <% elsif user_signed_in? && current_user.fan? && current_user.fan_profile %>
          <%= link_to "My Fan Page", fan_profile_path(current_user.fan_profile), class: "text-music-text hover:text-music-primary transition-colors" %>
        <% end %>
      </nav>
    </div>
    <div class="flex items-center space-x-4">
      <% if user_signed_in? %>
        <button class="p-2 rounded-full text-music-text hover:bg-music-primary hover:bg-opacity-20 transition-colors">
          <%= icon_tag "bell", class: "h-5 w-5" %>
        </button>
        <div class="relative" data-controller="dropdown">
          <button 
            data-action="dropdown#toggle click@window->dropdown#hide"
            data-dropdown-target="button"
            class="flex items-center space-x-2 focus:outline-none"
          >
            <% if current_user.profile&.avatar&.attached? %>
              <%= image_tag current_user.profile.avatar, class: "w-8 h-8 rounded-full object-cover" %>
            <% else %>
              <div class="w-8 h-8 rounded-full bg-music-primary flex items-center justify-center text-music-text">
                <%= current_user.name_or_email[0].upcase %>
              </div>
            <% end %>
            <span class="text-music-text"><%= current_user.name_or_email %></span>
            <%= icon_tag "chevron-down", variant: :mini, class: "h-4 w-4 text-music-text" %>
          </button>
          <div 
            data-dropdown-target="menu"
            class="absolute right-0 mt-2 w-48 bg-music-surface border border-music-surface rounded-md shadow-lg py-1 z-50 hidden"
            data-transition-enter="transition ease-out duration-100"
            data-transition-enter-start="transform opacity-0 scale-95"
            data-transition-enter-end="transform opacity-100 scale-100"
            data-transition-leave="transition ease-in duration-75"
            data-transition-leave-start="transform opacity-100 scale-100"
            data-transition-leave-end="transform opacity-0 scale-95"
          >
            <% if current_user.artist? %>
              <%= link_to "My Artist Page", artist_profile_path(current_user.artist_profile), class: "block px-4 py-2 text-music-text hover:bg-music-primary hover:bg-opacity-20" %>
              <%= link_to "Dashboard", dashboard_path, class: "block px-4 py-2 text-music-text hover:bg-music-primary hover:bg-opacity-20" %>
            <% elsif current_user.fan? && current_user.fan_profile %>
              <%= link_to "My Fan Page", fan_profile_path(current_user.fan_profile), class: "block px-4 py-2 text-music-text hover:bg-music-primary hover:bg-opacity-20" %>
            <% end %>
            <div class="border-t border-music-surface"></div>
            <%= link_to "Account Settings", edit_user_registration_path, class: "block px-4 py-2 text-music-text hover:bg-music-primary hover:bg-opacity-20" %>
            <div class="border-t border-music-surface"></div>
            <%= button_to "Sign Out", destroy_user_session_path, method: :delete, 
                          class: "w-full text-left px-4 py-2 text-music-text hover:bg-music-primary hover:bg-opacity-20" %>
          </div>
        </div>
      <% else %>
        <div class="flex space-x-2">
          <%= link_to "Sign In", new_user_session_path, class: "px-3 py-1 bg-music-primary text-music-text rounded-button hover:bg-opacity-90 transition-colors text-sm shadow-button" %>
          <%= link_to "Sign Up", new_user_registration_path, class: "px-3 py-1 bg-music-secondary text-music-text rounded-button hover:bg-opacity-90 transition-colors text-sm shadow-button" %>
        </div>
      <% end %>
    </div>
  </div>
</header>