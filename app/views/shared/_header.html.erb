<!-- Header -->
<header class="bg-indigo-900 text-white shadow-md">
  <div class="container mx-auto px-4 py-3 flex justify-between items-center">
    <div class="flex items-center space-x-4">
      <%= link_to root_path, class: "text-2xl font-bold" do %>
        ArtSound
      <% end %>
      <nav class="hidden md:flex space-x-6">
        <%= link_to "Music", "#", class: "hover:text-indigo-200" %>
        <%= link_to "Merch", "#", class: "hover:text-indigo-200" %>
        <%= link_to "Stats", "#", class: "hover:text-indigo-200" %>
        <%= link_to "Fans", "#", class: "hover:text-indigo-200" %>
        <% if user_signed_in? && current_user.artist? %>
          <%= link_to "My Artist Page", artist_profile_path(current_user.artist_profile), class: "hover:text-indigo-200" %>
        <% end %>
      </nav>
    </div>
    <div class="flex items-center space-x-4">
      <% if user_signed_in? %>
        <button class="p-2 rounded-full hover:bg-indigo-800">
          <%= icon_tag "bell", class: "h-5 w-5" %>
        </button>
        <div class="relative" data-controller="dropdown">
          <button 
            data-action="dropdown#toggle click@window->dropdown#hide"
            data-dropdown-target="button"
            class="flex items-center space-x-2 focus:outline-none"
          >
            <% if current_user.profile&.avatar&.attached? %>
              <%= image_tag current_user.profile.avatar, class: "w-8 h-8 rounded-full object-cover" %>
            <% else %>
              <div class="w-8 h-8 rounded-full bg-indigo-600 flex items-center justify-center text-white">
                <%= current_user.name_or_email[0].upcase %>
              </div>
            <% end %>
            <span><%= current_user.name_or_email %></span>
            <%= icon_tag "chevron-down", variant: :mini, class: "h-4 w-4" %>
          </button>
          <div 
            data-dropdown-target="menu"
            class="absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 z-50 hidden"
            data-transition-enter="transition ease-out duration-100"
            data-transition-enter-start="transform opacity-0 scale-95"
            data-transition-enter-end="transform opacity-100 scale-100"
            data-transition-leave="transition ease-in duration-75"
            data-transition-leave-start="transform opacity-100 scale-100"
            data-transition-leave-end="transform opacity-0 scale-95"
          >
            <%= link_to "Profile", edit_user_registration_path, class: "block px-4 py-2 text-gray-800 hover:bg-indigo-100" %>
            <% if current_user.artist? %>
              <%= link_to "Artist Dashboard", home_index_path, class: "block px-4 py-2 text-gray-800 hover:bg-indigo-100" %>
            <% end %>
            <div class="border-t border-gray-200"></div>
            <%= button_to "Sign Out", destroy_user_session_path, method: :delete, 
                          class: "w-full text-left px-4 py-2 text-gray-800 hover:bg-indigo-100" %>
          </div>
        </div>
      <% else %>
        <div class="flex space-x-2">
          <%= link_to "Sign In", new_user_session_path, class: "px-3 py-1 bg-indigo-600 text-white rounded hover:bg-indigo-700 text-sm" %>
          <%= link_to "Sign Up", new_user_registration_path, class: "px-3 py-1 bg-white text-indigo-900 rounded hover:bg-gray-100 text-sm" %>
        </div>
      <% end %>
    </div>
  </div>
</header>