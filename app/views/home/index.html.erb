<div class="min-h-screen flex flex-col items-center justify-center bg-gray-100 px-4 py-8">
  <h1 class="text-4xl font-bold text-blue-600">Welcome to My App</h1>
  <p class="mt-2 text-gray-700 text-center">Your ultimate fashion and ticketing platform.</p>

  <% if user_signed_in? %>
    <p class="mt-6 text-green-600 text-lg">
      You are signed in as <strong><%= current_user.name || current_user.email %></strong>!
    </p>
    <%= link_to "Go to Dashboard", root_path, class: "mt-4 px-5 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition" %>

    <%= button_to "Sign Out", destroy_user_session_path, method: :delete,
          class: "mt-2 px-5 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition" %>
  <% else %>
    <div class="mt-6 flex space-x-4">
      <%= link_to "Sign In", new_user_session_path, class: "px-5 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition" %>
      <%= link_to "Sign Up", new_user_registration_path, class: "px-5 py-2 bg-green-500 text-white rounded-lg hover:bg-green-600 transition" %>
      <%= button_to "Sign Out", destroy_user_session_path, method: :delete,
      class: "mt-2 px-5 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition" %>
    </div>
  <% end %>
</div>
