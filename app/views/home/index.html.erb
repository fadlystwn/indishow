
<body class="min-h-screen text-music-text">
  
  <!-- Hero Section -->
  <div class="bg-music-surface">
    <div class="max-w-7xl mx-auto py-16 px-4 sm:py-24 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl font-display tracking-tight text-music-text sm:text-5xl lg:text-6xl">
        Discover amazing independent music
      </h1>
      <p class="mt-6 max-w-3xl mx-auto text-xl text-music-text-secondary">
        Support artists directly. Keep 100% of your sales.
      </p>
      <div class="mt-10 flex justify-center">
        <div class="inline-flex rounded-button shadow-button">
          <a href="#" class="inline-flex items-center justify-center px-5 py-3 border border-transparent text-base font-medium rounded-button bg-music-primary hover:bg-opacity-90 text-music-text transition duration-200">
            Browse artists
          </a>
        </div>
        <div class="ml-3 inline-flex">
          <% if user_signed_in? && current_user.artist? %>
            <%= link_to step1_release_wizard_index_path, class: "inline-flex items-center justify-center px-5 py-3 border border-music-text text-base font-medium rounded-button text-music-text hover:bg-music-surface hover:border-music-primary transition duration-200" do %>
              Sell your music
            <% end %>
          <% elsif !user_signed_in? %>
            <%= link_to new_user_registration_path, class: "inline-flex items-center justify-center px-5 py-3 border border-music-text text-base font-medium rounded-button text-music-text hover:bg-music-surface hover:border-music-primary transition duration-200" do %>
              Sell your music
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Featured Albums - Bandcamp Style -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex justify-between items-center mb-6">
      <h2 class="text-xl font-bold text-gray-900 dark:text-white">Featured albums</h2>
      <%= link_to releases_path, class: "text-sm text-gray-600 dark:text-gray-300 hover:text-black dark:hover:text-white hover:underline" do %>
        View all →
      <% end %>
    </div>
  
    <%= render 'shared/album_list', 
        releases: @featured_releases,
        layout: 'grid',
        show_play_button: true,
        show_price: true,
        show_release_type: false,
        show_artist: true,
        show_date: false,
        grid_cols: 'grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5',
        empty_message: 'No featured albums',
        empty_icon: 'fas fa-star' %>
  </div>

  <!-- Genres Section -->
  <div class="bg-music-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="flex justify-between items-center mb-8">
        <h2 class="text-2xl font-bold text-music-text">Browse by genre</h2>
        <a href="#" class="text-sm font-medium text-music-primary hover:text-opacity-90">View all genres</a>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
        <a href="#" class="p-4 rounded-genre shadow-genre hover:shadow-genre-hover text-center bg-gradient-to-br from-music-genre-rock to-music-surface transition-all duration-200">
          <div class="mx-auto h-12 w-12 rounded-full bg-music-surface/30 flex items-center justify-center mb-2">
            <i class="fas fa-guitar text-music-text"></i>
          </div>
          <span class="text-sm font-medium text-music-text">Rock</span>
        </a>

        <a href="#" class="p-4 rounded-genre shadow-genre hover:shadow-genre-hover text-center bg-gradient-to-br from-music-genre-electronic to-music-surface transition-all duration-200">
          <div class="mx-auto h-12 w-12 rounded-full bg-music-surface/30 flex items-center justify-center mb-2">
            <i class="fas fa-headphones text-music-text"></i>
          </div>
          <span class="text-sm font-medium text-music-text">Electronic</span>
        </a>

        <a href="#" class="p-4 rounded-genre shadow-genre hover:shadow-genre-hover text-center bg-gradient-to-br from-music-genre-hiphop to-music-surface transition-all duration-200">
          <div class="mx-auto h-12 w-12 rounded-full bg-music-surface/30 flex items-center justify-center mb-2">
            <i class="fas fa-drum text-music-text"></i>
          </div>
          <span class="text-sm font-medium text-music-text">Hip Hop</span>
        </a>

        <a href="#" class="p-4 rounded-genre shadow-genre hover:shadow-genre-hover text-center bg-gradient-to-br from-music-genre-classical to-music-surface transition-all duration-200">
          <div class="mx-auto h-12 w-12 rounded-full bg-music-surface/30 flex items-center justify-center mb-2">
            <i class="fas fa-music text-music-text"></i>
          </div>
          <span class="text-sm font-medium text-music-text">Classical</span>
        </a>

        <a href="#" class="p-4 rounded-genre shadow-genre hover:shadow-genre-hover text-center bg-gradient-to-br from-music-genre-indie to-music-surface transition-all duration-200">
          <div class="mx-auto h-12 w-12 rounded-full bg-music-surface/30 flex items-center justify-center mb-2">
            <i class="fas fa-record-vinyl text-music-text"></i>
          </div>
          <span class="text-sm font-medium text-music-text">Indie</span>
        </a>

        <a href="#" class="p-4 rounded-genre shadow-genre hover:shadow-genre-hover text-center bg-gradient-to-br from-music-genre-world to-music-surface transition-all duration-200">
          <div class="mx-auto h-12 w-12 rounded-full bg-music-surface/30 flex items-center justify-center mb-2">
            <i class="fas fa-microphone text-music-text"></i>
          </div>
          <span class="text-sm font-medium text-music-text">World</span>
        </a>
      </div>
    </div>
  </div>

</body>
