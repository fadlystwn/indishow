<!-- Upload Release Section -->
<div class="bg-white rounded-lg shadow-sm border border-gray-100 p-6 mb-8">
  <h2 class="text-xl font-semibold mb-4">Upload New Release</h2>
  
  <!-- Release Type Selector -->
  <div class="mb-6" data-controller="release-upload">
    <label class="block text-gray-700 text-sm font-medium mb-2">Release Type</label>
    <div class="grid grid-cols-4 gap-2">
      <button type="button" class="release-type-btn py-2 px-4 border rounded-md text-sm font-medium border-gray-300 text-gray-700" 
              data-release-upload-target="typeBtn" 
              data-action="click->release-upload#selectType" 
              data-type="single">
        Single
      </button>
      <button type="button" class="release-type-btn py-2 px-4 border rounded-md text-sm font-medium border-gray-300 text-gray-700" 
              data-release-upload-target="typeBtn" 
              data-action="click->release-upload#selectType" 
              data-type="ep">
        EP
      </button>
      <button type="button" class="release-type-btn py-2 px-4 border rounded-md text-sm font-medium border-gray-300 text-gray-700" 
              data-release-upload-target="typeBtn" 
              data-action="click->release-upload#selectType" 
              data-type="album">
        Album
      </button>
      <button type="button" class="release-type-btn py-2 px-4 border rounded-md text-sm font-medium border-gray-300 text-gray-700" 
              data-release-upload-target="typeBtn" 
              data-action="click->release-upload#selectType" 
              data-type="compilation">
        Compilation
      </button>
    </div>
  </div>

  <!-- Upload Form -->
  <form>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Left Column -->
      <div>
        <!-- Cover Art Upload -->
        <div class="mb-4">
          <label class="block text-gray-700 text-sm font-medium mb-2">Cover Art</label>
          <div class="border-2 border-dashed border-gray-300 rounded-lg p-8 text-center">
            <i class="fas fa-image text-gray-400 text-4xl mb-2"></i>
            <p class="text-gray-500 text-sm">Drag & drop your cover art here</p>
            <p class="text-gray-400 text-xs mt-1">or click to browse (1200x1200px recommended)</p>
          </div>
        </div>

        <!-- Audio Upload -->
        <div class="mb-4">
          <label class="block text-gray-700 text-sm font-medium mb-2">Audio Files</label>
          <div class="border-2 border-dashed border-gray-300 rounded-lg p-8 text-center">
            <i class="fas fa-music text-gray-400 text-4xl mb-2"></i>
            <p class="text-gray-500 text-sm">Drag & drop your audio files here</p>
            <p class="text-gray-400 text-xs mt-1">or click to browse (WAV, FLAC, AIFF, ALAC, MP3, AAC)</p>
          </div>
        </div>
      </div>

      <!-- Right Column -->
      <div>
        <!-- Release Info -->
        <div class="mb-4">
          <label for="title" class="block text-gray-700 text-sm font-medium mb-2">Title</label>
          <input type="text" id="title" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-teal-500">
        </div>

        <div class="mb-4">
          <label for="artist" class="block text-gray-700 text-sm font-medium mb-2">Artist</label>
          <input type="text" id="artist" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-teal-500">
        </div>

        <div class="mb-4">
          <label for="release-date" class="block text-gray-700 text-sm font-medium mb-2">Release Date</label>
          <input type="date" id="release-date" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-teal-500">
        </div>

        <div class="mb-4">
          <label for="price" class="block text-gray-700 text-sm font-medium mb-2">Price</label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-500">$</span>
            <input type="number" id="price" min="0" step="0.01" class="w-full pl-8 pr-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-teal-500">
          </div>
        </div>

        <div class="mb-4">
          <label for="description" class="block text-gray-700 text-sm font-medium mb-2">Description</label>
          <textarea id="description" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-teal-500"></textarea>
        </div>

        <div class="flex justify-end mt-6">
          <button type="button" class="px-4 py-2 border border-gray-300 rounded-md text-gray-700 mr-2 hover:bg-gray-50">Cancel</button>
          <button type="submit" class="px-4 py-2 bg-teal-600 text-white rounded-md hover:bg-teal-700 focus:outline-none focus:ring-2 focus:ring-teal-500">Upload Release</button>
        </div>
      </div>
    </div>
  </form>
</div>