<div class="min-h-screen bg-music-background py-8">
  <div class="max-w-4xl mx-auto px-4">
    <!-- Progress Bar -->
    <div class="mb-8">
      <div class="flex items-center justify-center mb-4">
        <div class="flex items-center space-x-4">
          <div class="flex items-center">
            <div class="w-8 h-8 bg-green-600 text-white rounded-full flex items-center justify-center text-sm font-medium">✓</div>
            <span class="ml-2 text-sm font-medium text-green-600">Select Type</span>
          </div>
          <div class="w-16 h-1 bg-green-600 rounded"></div>
          <div class="flex items-center">
            <div class="w-8 h-8 bg-teal-600 text-white rounded-full flex items-center justify-center text-sm font-medium">2</div>
            <span class="ml-2 text-sm font-medium text-music-text">Release Info</span>
          </div>
          <div class="w-16 h-1 bg-gray-300 rounded"></div>
          <div class="flex items-center">
            <div class="w-8 h-8 bg-gray-300 text-gray-500 rounded-full flex items-center justify-center text-sm font-medium">3</div>
            <span class="ml-2 text-sm font-medium text-gray-500">Upload Tracks</span>
          </div>
        </div>
      </div>
      <div class="w-full bg-gray-300 rounded-full h-2">
        <div class="bg-teal-600 h-2 rounded-full transition-all duration-300" style="width: 66.66%" data-release-wizard-target="progressBar"></div>
      </div>
    </div>

    <!-- Main Content -->
    <div class="bg-music-surface rounded-lg shadow-lg border border-music-border p-8">
      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-music-text mb-2">Release Information</h1>
        <p class="text-music-text-secondary text-lg">
          Tell us about your <%= @release.release_type&.titleize || 'release' %>
        </p>
      </div>

      <%= form_tag update_step_release_wizard_path(@release.id), method: :post, local: true, authenticity_token: true, class: "space-y-6" do %>
        <%= hidden_field_tag 'release[release_type]', @release.release_type %>
        <input type="hidden" name="step" value="2">

        <% if @release.errors.any? %>
          <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-md">
            <h3 class="font-semibold mb-2 text-red-800">Please correct the following errors:</h3>
            <ul class="list-disc list-inside text-sm text-red-700">
              <% @release.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <!-- Left Column: Cover Art -->
          <div>
            <div class="mb-6">
              <%= label_tag 'release[cover_art]', "Cover Art", class: "block text-music-text text-sm font-medium mb-2" %>
              <div class="border-2 border-dashed border-music-border rounded-lg p-8 text-center cursor-pointer bg-music-background/50 hover:border-teal-500 hover:bg-teal-50 transition-all duration-200"
                   data-controller="image-upload-base"
                   data-action="dragover->image-upload-base#highlight dragleave->image-upload-base#unhighlight drop->image-upload-base#drop">
                <div data-image-upload-base-target="container" 
                     class="cursor-pointer <%= 'hidden' if @release.cover_art.attached? %>">
                  <i class="fas fa-image text-music-text-secondary text-4xl mb-4"></i>
                  <p class="text-music-text-secondary text-sm mb-2">Drag & drop your cover art here</p>
                  <p class="text-music-text-secondary/70 text-xs">or click to browse (1200x1200px recommended)</p>
                </div>
                <div data-image-upload-base-target="preview" class="<%= 'hidden' unless @release.cover_art.attached? %>">
                  <% if @release.cover_art.attached? %>
                    <div class="flex flex-col items-center">
                      <div class="relative">
                        <%= image_tag @release.cover_art.variant(:medium), class: "max-w-full max-h-64 rounded-md mb-2" %>
                        <button type="button" 
                                class="absolute top-0 right-0 bg-red-500 text-white rounded-full w-6 h-6 flex items-center justify-center hover:bg-red-600 shadow-lg"
                                data-action="click->image-upload-base#clearFile">
                          ×
                        </button>
                      </div>
                      <p class="text-sm text-music-text-secondary mt-2"><%= @release.cover_art.filename %></p>
                    </div>
                  <% end %>
                </div>
                <%= file_field_tag 'release[cover_art]', 
                                  direct_upload: true,
                                  accept: "image/*",
                                  class: "hidden",
                                  data: { image_upload_base_target: "input", action: "change->image-upload-base#inputChange" } %>
              </div>
              <% if @release.errors[:cover_art].any? %>
                <p class="text-sm text-red-500 mt-1"><%= @release.errors.full_messages_for(:cover_art).first %></p>
              <% end %>
            </div>
          </div>

          <!-- Right Column: Release Details -->
          <div class="space-y-6">
            <!-- Title -->
            <div>
              <%= label_tag 'release[title]', 'Title', class: "block text-music-text text-sm font-medium mb-2" %>
              <%= text_field_tag 'release[title]', @release.title,
                                class: "w-full px-3 py-2 border border-music-border rounded-md bg-music-background text-music-text placeholder-music-text-secondary #{'border-red-500' if @release.errors[:title].any?} focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500",
                                placeholder: "Enter your #{@release.release_type&.titleize&.downcase || 'release'} title" %>
              <% if @release.errors[:title].any? %>
                <p class="text-sm text-red-500 mt-1"><%= @release.errors.full_messages_for(:title).first %></p>
              <% end %>
            </div>

            <!-- Artist -->
            <div>
              <%= label_tag 'release[artist]', 'Artist', class: "block text-music-text text-sm font-medium mb-2" %>
              <%= text_field_tag 'release[artist]', @release.artist,
                                class: "w-full px-3 py-2 border border-music-border rounded-md bg-music-background text-music-text placeholder-music-text-secondary #{'border-red-500' if @release.errors[:artist].any?} focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500",
                                placeholder: "Artist or band name" %>
              <% if @release.errors[:artist].any? %>
                <p class="text-sm text-red-500 mt-1"><%= @release.errors.full_messages_for(:artist).first %></p>
              <% end %>
            </div>

            <!-- Release Date -->
            <div>
              <%= label_tag 'release[release_date]', 'Release Date', class: "block text-music-text text-sm font-medium mb-2" %>
              <%= date_field_tag 'release[release_date]', @release.release_date,
                                class: "w-full px-3 py-2 border border-music-border rounded-md bg-music-background text-music-text #{'border-red-500' if @release.errors[:release_date].any?} focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500" %>
              <% if @release.errors[:release_date].any? %>
                <p class="text-sm text-red-500 mt-1"><%= @release.errors.full_messages_for(:release_date).first %></p>
              <% end %>
            </div>

            <!-- Price -->
            <div>
              <%= label_tag 'release[price]', 'Price', class: "block text-music-text text-sm font-medium mb-2" %>
              <div class="relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-music-text-secondary">$</span>
                <%= number_field_tag 'release[price]', @release.price,
                                    min: 0, 
                                    step: 0.01, 
                                    class: "w-full pl-8 pr-3 py-2 border border-music-border rounded-md bg-music-background text-music-text #{'border-red-500' if @release.errors[:price].any?} focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500",
                                    placeholder: "0.00" %>
              </div>
              <% if @release.errors[:price].any? %>
                <p class="text-sm text-red-500 mt-1"><%= @release.errors.full_messages_for(:price).first %></p>
              <% end %>
              <p class="text-xs text-music-text-secondary mt-1">Set to $0.00 for free releases</p>
            </div>

            <!-- Genre -->
            <div>
              <%= label_tag 'release[genre]', 'Genre', class: "block text-music-text text-sm font-medium mb-2" %>
              <%= select_tag 'release[genre]', 
                            options_for_select([['Select a genre', '']] + Release::GENRES.map { |genre| [genre, genre] }, @release.genre), 
                            class: "w-full px-3 py-2 border border-music-border rounded-md bg-music-background text-music-text #{'border-red-500' if @release.errors[:genre].any?} focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500" %>
              <% if @release.errors[:genre].any? %>
                <p class="text-sm text-red-500 mt-1"><%= @release.errors.full_messages_for(:genre).first %></p>
              <% end %>
            </div>

            <!-- Description -->
            <div>
              <%= label_tag 'release[description]', 'Description', class: "block text-music-text text-sm font-medium mb-2" %>
              <%= text_area_tag 'release[description]', @release.description,
                                rows: 4, 
                                class: "w-full px-3 py-2 border border-music-border rounded-md bg-music-background text-music-text placeholder-music-text-secondary #{'border-red-500' if @release.errors[:description].any?} focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500",
                                placeholder: "Tell your fans about this #{@release.release_type&.titleize&.downcase || 'release'}..." %>
              <% if @release.errors[:description].any? %>
                <p class="text-sm text-red-500 mt-1"><%= @release.errors.full_messages_for(:description).first %></p>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Navigation -->
        <div class="flex justify-between items-center pt-6 border-t border-music-border">
          <%= link_to "Back", step1_release_wizard_index_path, 
                      class: "px-6 py-3 border border-music-border rounded-md text-music-text hover:bg-music-background transition-colors" %>
          
          <%= submit_tag "Continue to Upload Tracks", 
                        class: "px-6 py-3 bg-teal-600 text-white rounded-md font-medium hover:bg-teal-700 focus:outline-none focus:ring-2 focus:ring-teal-500 transition-colors" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
