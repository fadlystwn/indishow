<div class="min-h-screen bg-music-background py-8">
  <div class="max-w-5xl mx-auto px-4">
    <!-- Enhanced Progress Bar -->
    <div class="mb-12">
      <div class="flex items-center justify-center mb-4">
        <div class="flex items-center space-x-2 md:space-x-4">
          <!-- Step 1 -->
          <div class="flex flex-col items-center">
            <div class="w-10 h-10 bg-music-primary text-music-background rounded-full flex items-center justify-center text-sm font-bold border-2 border-music-primary">
              <i class="fas fa-check text-xs"></i>
            </div>
            <span class="mt-2 text-sm font-medium text-music-primary">Select Type</span>
          </div>
          
          <div class="w-16 h-1 bg-music-primary rounded-full"></div>

          <!-- Step 2 -->
          <div class="flex flex-col items-center">
            <div class="w-10 h-10 bg-music-primary text-music-background rounded-full flex items-center justify-center text-sm font-bold border-2 border-music-primary">
              2
            </div>
            <span class="mt-2 text-sm font-medium text-music-text">Release Info</span>
          </div>
          
          <div class="w-16 h-1 bg-music-border rounded-full"></div>

          <!-- Step 3 -->
          <div class="flex flex-col items-center">
            <div class="w-10 h-10 bg-music-surface text-music-text-secondary rounded-full flex items-center justify-center text-sm font-bold border-2 border-music-border">
              3
            </div>
            <span class="mt-2 text-sm font-medium text-music-text-secondary">Upload Tracks</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content Card -->
    <div class="bg-music-surface rounded-genre shadow-genre border border-music-border/50 p-8 backdrop-blur-sm bg-opacity-90">
      <!-- Header -->
      <div class="text-center mb-10">
        <h1 class="text-3xl font-display tracking-tight text-music-text mb-3">Release Information</h1>
        <div class="w-20 h-1 bg-music-primary mx-auto mb-4"></div>
        <p class="text-music-text-secondary text-lg">
          Tell us about your <%= @release.release_type&.titleize || 'release' %>
        </p>
      </div>

      <%= form_tag update_step_release_wizard_path(@release.id), method: :post, local: true, authenticity_token: true, class: "space-y-8" do %>
        <%= hidden_field_tag 'release[release_type]', @release.release_type %>
        <input type="hidden" name="step" value="2">

        <% if @release.errors.any? %>
          <div class="mb-6 p-4 bg-red-500/10 border border-red-500/30 rounded-genre">
            <h3 class="font-semibold mb-2 text-red-500 flex items-center">
              <i class="fas fa-exclamation-circle mr-2"></i>
              Please correct the following errors:
            </h3>
            <ul class="list-disc list-inside text-sm text-red-400">
              <% @release.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <!-- Left Column: Cover Art -->
          <div>
            <div class="mb-6">
              <%= label_tag 'release[cover_art]', "Cover Art", class: "block text-music-text text-sm font-medium mb-3 uppercase tracking-wider" %>
              <div class="border-2 border-dashed border-music-border/50 rounded-genre p-8 text-center cursor-pointer bg-music-background/20 hover:border-music-primary hover:bg-music-primary/10 transition-all duration-300 group"
                   data-controller="image-upload-base"
                   data-action="dragover->image-upload-base#highlight dragleave->image-upload-base#unhighlight drop->image-upload-base#drop">
                <div data-image-upload-base-target="container" 
                     class="cursor-pointer <%= 'hidden' if @release.cover_art.attached? %>">
                  <i class="fas fa-image text-music-text-secondary/50 text-4xl mb-4 group-hover:text-music-primary transition-colors"></i>
                  <p class="text-music-text-secondary text-sm mb-2">Drag & drop your cover art here</p>
                  <p class="text-music-text-secondary/50 text-xs">(1200×1200px recommended)</p>
                </div>
                <div data-image-upload-base-target="preview" class="<%= 'hidden' unless @release.cover_art.attached? %>">
                  <% if @release.cover_art.attached? %>
                    <div class="flex flex-col items-center">
                      <div class="relative">
                        <%= image_tag @release.cover_art.variant(:medium), class: "max-w-full max-h-64 rounded-genre mb-2 shadow-genre" %>
                        <button type="button" 
                                class="absolute top-0 right-0 bg-music-primary text-music-background rounded-full w-6 h-6 flex items-center justify-center hover:bg-music-primary/90 shadow-lg transform hover:scale-110 transition-all"
                                data-action="click->image-upload-base#clearFile">
                          ×
                        </button>
                      </div>
                      <p class="text-sm text-music-text-secondary mt-2"><%= @release.cover_art.filename %></p>
                    </div>
                  <% end %>
                </div>
                <%= file_field_tag 'release[cover_art]', 
                                  direct_upload: true,
                                  accept: "image/*",
                                  class: "hidden",
                                  data: { image_upload_base_target: "input", action: "change->image-upload-base#inputChange" } %>
              </div>
              <% if @release.errors[:cover_art].any? %>
                <p class="text-sm text-red-400 mt-2 flex items-center">
                  <i class="fas fa-exclamation-circle mr-1"></i>
                  <%= @release.errors.full_messages_for(:cover_art).first %>
                </p>
              <% end %>
            </div>
          </div>

          <!-- Right Column: Release Details -->
          <div class="space-y-6">
            <!-- Title -->
            <div>
              <%= label_tag 'release[title]', 'Title', class: "block text-music-text text-sm font-medium mb-3 uppercase tracking-wider" %>
              <%= text_field_tag 'release[title]', @release.title,
                                class: "w-full px-4 py-3 border border-music-border/50 rounded-genre bg-music-background/20 text-music-text placeholder-music-text-secondary/50 #{'border-red-500' if @release.errors[:title].any?} focus:outline-none focus:ring-2 focus:ring-music-primary focus:border-music-primary transition-all",
                                placeholder: "Enter your #{@release.release_type&.titleize&.downcase || 'release'} title" %>
              <% if @release.errors[:title].any? %>
                <p class="text-sm text-red-400 mt-2 flex items-center">
                  <i class="fas fa-exclamation-circle mr-1"></i>
                  <%= @release.errors.full_messages_for(:title).first %>
                </p>
              <% end %>
            </div>

            <!-- Artist -->
            <div>
              <%= label_tag 'release[artist]', 'Artist', class: "block text-music-text text-sm font-medium mb-3 uppercase tracking-wider" %>
              <%= text_field_tag 'release[artist]', @release.artist,
                                class: "w-full px-4 py-3 border border-music-border/50 rounded-genre bg-music-background/20 text-music-text placeholder-music-text-secondary/50 #{'border-red-500' if @release.errors[:artist].any?} focus:outline-none focus:ring-2 focus:ring-music-primary focus:border-music-primary transition-all",
                                placeholder: "Artist or band name" %>
              <% if @release.errors[:artist].any? %>
                <p class="text-sm text-red-400 mt-2 flex items-center">
                  <i class="fas fa-exclamation-circle mr-1"></i>
                  <%= @release.errors.full_messages_for(:artist).first %>
                </p>
              <% end %>
            </div>

            <!-- Release Date -->
            <div>
              <%= label_tag 'release[release_date]', 'Release Date', class: "block text-music-text text-sm font-medium mb-3 uppercase tracking-wider" %>
              <%= date_field_tag 'release[release_date]', @release.release_date,
                                class: "w-full px-4 py-3 border border-music-border/50 rounded-genre bg-music-background/20 text-music-text #{'border-red-500' if @release.errors[:release_date].any?} focus:outline-none focus:ring-2 focus:ring-music-primary focus:border-music-primary transition-all" %>
              <% if @release.errors[:release_date].any? %>
                <p class="text-sm text-red-400 mt-2 flex items-center">
                  <i class="fas fa-exclamation-circle mr-1"></i>
                  <%= @release.errors.full_messages_for(:release_date).first %>
                </p>
              <% end %>
            </div>

            <!-- Price -->
            <div>
              <%= label_tag 'release[price]', 'Price', class: "block text-music-text text-sm font-medium mb-3 uppercase tracking-wider" %>
              <div class="relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-music-text-secondary">$</span>
                <%= number_field_tag 'release[price]', @release.price,
                                    min: 0, 
                                    step: 0.01, 
                                    class: "w-full pl-10 pr-4 py-3 border border-music-border/50 rounded-genre bg-music-background/20 text-music-text #{'border-red-500' if @release.errors[:price].any?} focus:outline-none focus:ring-2 focus:ring-music-primary focus:border-music-primary transition-all",
                                    placeholder: "0.00" %>
              </div>
              <% if @release.errors[:price].any? %>
                <p class="text-sm text-red-400 mt-2 flex items-center">
                  <i class="fas fa-exclamation-circle mr-1"></i>
                  <%= @release.errors.full_messages_for(:price).first %>
                </p>
              <% end %>
              <p class="text-xs text-music-text-secondary/50 mt-2">Set to $0.00 for free releases</p>
            </div>

            <!-- Genre -->
            <div>
              <%= label_tag 'release[genre]', 'Genre', class: "block text-music-text text-sm font-medium mb-3 uppercase tracking-wider" %>
              <%= select_tag 'release[genre]', 
                            options_for_select([['Select a genre', '']] + Release::GENRES.map { |genre| [genre, genre] }, @release.genre), 
                            class: "w-full px-4 py-3 border border-music-border/50 rounded-genre bg-music-background/20 text-music-text #{'border-red-500' if @release.errors[:genre].any?} focus:outline-none focus:ring-2 focus:ring-music-primary focus:border-music-primary transition-all appearance-none" %>
              <% if @release.errors[:genre].any? %>
                <p class="text-sm text-red-400 mt-2 flex items-center">
                  <i class="fas fa-exclamation-circle mr-1"></i>
                  <%= @release.errors.full_messages_for(:genre).first %>
                </p>
              <% end %>
            </div>

            <!-- Description -->
            <div>
              <%= label_tag 'release[description]', 'Description', class: "block text-music-text text-sm font-medium mb-3 uppercase tracking-wider" %>
              <%= text_area_tag 'release[description]', @release.description,
                                rows: 4, 
                                class: "w-full px-4 py-3 border border-music-border/50 rounded-genre bg-music-background/20 text-music-text placeholder-music-text-secondary/50 #{'border-red-500' if @release.errors[:description].any?} focus:outline-none focus:ring-2 focus:ring-music-primary focus:border-music-primary transition-all",
                                placeholder: "Tell your fans about this #{@release.release_type&.titleize&.downcase || 'release'}..." %>
              <% if @release.errors[:description].any? %>
                <p class="text-sm text-red-400 mt-2 flex items-center">
                  <i class="fas fa-exclamation-circle mr-1"></i>
                  <%= @release.errors.full_messages_for(:description).first %>
                </p>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Navigation -->
        <div class="flex justify-between items-center pt-8 border-t border-music-border/30">
          <%= link_to step1_release_wizard_index_path, 
                      class: "px-6 py-3 border border-music-border/50 rounded-genre text-music-text hover:bg-music-background/20 hover:border-music-primary transition-all flex items-center" do %>
            <i class="fas fa-arrow-left mr-2"></i>
            Back
          <% end %>
          
          <%= submit_tag "Continue to Upload Tracks", 
                        class: "px-8 py-3 bg-music-primary hover:bg-music-primary/90 text-music-background rounded-button font-display tracking-wider text-lg transition-all duration-300 shadow-button hover:shadow-genre-hover" %>
        </div>
      <% end %>
    </div>
  </div>
</div>