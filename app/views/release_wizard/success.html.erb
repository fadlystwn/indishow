<div class="min-h-screen bg-music-background flex items-center justify-center py-8">
  <div class="max-w-2xl mx-auto px-4 text-center">
    <!-- Success Animation Container -->
    <div class="bg-music-surface rounded-lg shadow-lg border border-music-border p-12 mb-8">
      
      <!-- Success Icon -->
      <div class="flex justify-center mb-6">
        <div class="w-24 h-24 bg-green-100 rounded-full flex items-center justify-center animate-pulse">
          <svg class="w-12 h-12 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
          </svg>
        </div>
      </div>

      <!-- Success Message -->
      <h1 class="text-3xl font-bold text-music-text mb-4">
        🎉 Release Published Successfully!
      </h1>
      
      <div class="mb-6">
        <h2 class="text-xl font-semibold text-music-text mb-2">
          "<%= @release.title %>" by <%= @release.artist %>
        </h2>
        <p class="text-music-text-secondary">
          Your <%= @release.release_type.titleize %> is now live and available for purchase!
        </p>
      </div>

      <!-- Release Info -->
      <div class="bg-music-background rounded-lg p-6 mb-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
          <div>
            <span class="font-medium text-music-text">Release Date:</span>
            <span class="text-music-text-secondary ml-2"><%= @release.release_date.strftime("%B %d, %Y") %></span>
          </div>
          <div>
            <span class="font-medium text-music-text">Type:</span>
            <span class="text-music-text-secondary ml-2"><%= @release.release_type.titleize %></span>
          </div>
          <div>
            <span class="font-medium text-music-text">Tracks:</span>
            <span class="text-music-text-secondary ml-2"><%= @release.tracks.count %></span>
          </div>
          <div>
            <span class="font-medium text-music-text">Price:</span>
            <span class="text-music-text-secondary ml-2">$<%= number_with_precision(@release.price, precision: 2) %></span>
          </div>
        </div>
      </div>

      <!-- Auto-redirect Message -->
      <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
        <p class="text-blue-800 text-sm">
          <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
          </svg>
          You'll be redirected to your releases in <span id="countdown">5</span> seconds
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <%= link_to releases_path, 
            class: "bg-teal-600 hover:bg-teal-700 text-white font-medium py-3 px-6 rounded-lg transition-colors duration-200" do %>
          <svg class="w-5 h-5 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
          </svg>
          View My Releases
        <% end %>
        
        <%= link_to release_path(@release), 
            class: "bg-gray-600 hover:bg-gray-700 text-white font-medium py-3 px-6 rounded-lg transition-colors duration-200" do %>
          <svg class="w-5 h-5 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
          </svg>
          View Release Page
        <% end %>
      </div>

      <!-- Share Options -->
      <div class="mt-8 pt-6 border-t border-music-border">
        <p class="text-music-text-secondary text-sm mb-4">Share your new release:</p>
        <div class="flex justify-center space-x-4">
          <button onclick="shareOnTwitter()" 
                  class="bg-blue-500 hover:bg-blue-600 text-white p-2 rounded-lg transition-colors duration-200">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
            </svg>
          </button>
          
          <button onclick="shareOnFacebook()" 
                  class="bg-blue-700 hover:bg-blue-800 text-white p-2 rounded-lg transition-colors duration-200">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </button>
          
          <button onclick="copyReleaseLink()" 
                  class="bg-gray-600 hover:bg-gray-700 text-white p-2 rounded-lg transition-colors duration-200">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Auto-redirect countdown
  let countdown = 5;
  const countdownElement = document.getElementById('countdown');

  const timer = setInterval(() => {
    countdown--;
    countdownElement.textContent = countdown;
    
    if (countdown <= 0) {
      clearInterval(timer);
      window.location.href = '<%= releases_path %>';
    }
  }, 1000);

  // Define variables with proper escaping
  const releaseData = {
    type: '<%= j(@release.release_type) %>',
    title: '<%= j(@release.title) %>',
    artist: '<%= j(@release.artist) %>',
    url: '<%= j(release_url(@release)) %>'
  };

  // Social sharing functions
  window.shareOnTwitter = function() {
    const text = `🎵 Just released my new ${releaseData.type}: "${releaseData.title}" by ${releaseData.artist}! Check it out:`;
    const url = releaseData.url;
    window.open(`https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}&url=${encodeURIComponent(url)}`, '_blank');
  };

  window.shareOnFacebook = function() {
    const url = releaseData.url;
    window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`, '_blank');
  };

  window.copyReleaseLink = function() {
    const url = releaseData.url;
    navigator.clipboard.writeText(url).then(() => {
      // Show a temporary success message
      const button = event.target.closest('button');
      const originalContent = button.innerHTML;
      button.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';
      button.classList.remove('bg-gray-600', 'hover:bg-gray-700');
      button.classList.add('bg-green-600');
      
      setTimeout(() => {
        button.innerHTML = originalContent;
        button.classList.remove('bg-green-600');
        button.classList.add('bg-gray-600', 'hover:bg-gray-700');
      }, 2000);
    }).catch((err) => {
      console.error('Failed to copy link:', err);
      alert('Failed to copy link. Please copy it manually: ' + url);
    });
  };
});
</script>