<%= form_tag publish_release_wizard_path(@release_draft), method: :post, class: "space-y-6" do %>
  <div class="bg-music-surface rounded-lg p-6">
    <h3 class="text-xl font-semibold text-music-text mb-4">Ready to Publish?</h3>
    
    <p class="text-music-text-secondary mb-4">
      Once published, your release will be available to your fans and cannot be unpublished.
      Please review all details carefully before proceeding.
    </p>

    <div class="flex justify-end space-x-4">
      <%= link_to "Make Changes", 
          step3_release_wizard_path(@release_draft),
          class: "px-4 py-2 text-sm font-medium text-music-text-secondary hover:text-music-text transition-colors duration-200" %>
      
      <%= submit_tag "Publish Release", 
          class: "bg-teal-600 hover:bg-teal-700 text-white font-medium py-2 px-6 rounded-lg transition-colors duration-200",
          data: { confirm: "Are you sure you want to publish this release? This action cannot be undone." } %>
    </div>
  </div>
<% end %>
