<div class="min-h-screen bg-music-background py-8">
  <div class="max-w-4xl mx-auto px-4">
    <!-- Progress Bar -->
    <div class="mb-8">
      <div class="flex items-center justify-center mb-4">
        <div class="flex items-center space-x-4">
          <div class="flex items-center">
            <div class="w-8 h-8 bg-green-600 text-white rounded-full flex items-center justify-center text-sm font-medium">✓</div>
            <span class="ml-2 text-sm font-medium text-green-600">Select Type</span>
          </div>
          <div class="w-16 h-1 bg-green-600 rounded"></div>
          <div class="flex items-center">
            <div class="w-8 h-8 bg-green-600 text-white rounded-full flex items-center justify-center text-sm font-medium">✓</div>
            <span class="ml-2 text-sm font-medium text-green-600">Release Info</span>
          </div>
          <div class="w-16 h-1 bg-green-600 rounded"></div>
          <div class="flex items-center">
            <div class="w-8 h-8 bg-teal-600 text-white rounded-full flex items-center justify-center text-sm font-medium">3</div>
            <span class="ml-2 text-sm font-medium text-music-text">Upload Tracks</span>
          </div>
        </div>
      </div>
      <div class="w-full bg-gray-300 rounded-full h-2">
        <div class="bg-teal-600 h-2 rounded-full transition-all duration-300" style="width: 100%" data-release-wizard-target="progressBar"></div>
      </div>
    </div>

    <!-- Main Content -->
    <div class="bg-music-surface rounded-lg shadow-lg border border-music-border p-8"
         data-controller="release-wizard" 
         data-release-wizard-step-value="3"
         data-release-wizard-selected-type-value="<%= @release.release_type %>"
         data-release-wizard-track-requirements-value="<%= @track_requirements.to_json %>"
         data-release-wizard-base-url-value="<%= release_wizard_path(@release.id) %>"
         data-release-wizard-update-url-value="<%= update_step_release_wizard_path(@release.id) %>">
      
      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-music-text mb-2">Upload Your Tracks</h1>
        <p class="text-music-text-secondary text-lg mb-4">
          Add tracks to your <%= @release.release_type.titleize.downcase %>
        </p>
        <div class="inline-flex items-center px-4 py-2 bg-teal-50 border border-teal-200 rounded-md">
          <i class="fas fa-info-circle text-teal-600 mr-2"></i>
          <span class="text-sm text-teal-800">
            <%= @track_requirements[:description] %>
          </span>
        </div>
      </div>

      <% if flash[:alert] %>
        <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-md text-red-700">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <!-- Track Upload Section -->
      <div class="mb-8" data-release-wizard-target="trackUpload">
        <div class="border-2 border-dashed border-gray-300 rounded-lg p-8 text-center bg-gray-50 hover:border-teal-400 hover:bg-teal-50 transition-all duration-200 cursor-pointer group"
             data-action="dragover->release-wizard#highlight dragleave->release-wizard#unhighlight drop->release-wizard#drop click->release-wizard#triggerFileInput">
          <div class="upload-container">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-gray-100 rounded-full mb-4 group-hover:bg-teal-50 transition-colors">
              <i class="fas fa-music text-gray-400 text-3xl group-hover:text-teal-500 transition-colors"></i>
            </div>
            <h3 class="text-lg font-medium text-gray-900 mb-2">Upload Audio Files</h3>
            <p class="text-gray-600 upload-description mb-4">
              <%= @track_requirements[:description] %>
            </p>
            <div class="max-w-sm mx-auto bg-white rounded-lg border border-gray-200 p-4 mb-4">
              <div class="text-sm text-left">
                <h4 class="font-medium text-gray-900 mb-2">Supported Formats:</h4>
                <div class="grid grid-cols-2 gap-2">
                  <div class="flex items-center text-gray-600">
                    <i class="fas fa-check text-green-500 mr-2 text-xs"></i>
                    <span>WAV, FLAC</span>
                  </div>
                  <div class="flex items-center text-gray-600">
                    <i class="fas fa-check text-green-500 mr-2 text-xs"></i>
                    <span>AIFF, ALAC</span>
                  </div>
                  <div class="flex items-center text-gray-600">
                    <i class="fas fa-check text-green-500 mr-2 text-xs"></i>
                    <span>MP3, AAC</span>
                  </div>
                  <div class="flex items-center text-gray-600">
                    <i class="fas fa-check text-green-500 mr-2 text-xs"></i>
                    <span>Max 100MB</span>
                  </div>
                </div>
              </div>
            </div>
            <div class="flex flex-col items-center">
              <label class="inline-flex items-center px-6 py-3 bg-teal-600 text-white rounded-lg cursor-pointer hover:bg-teal-700 transition-colors shadow-sm">
                <i class="fas fa-upload mr-2"></i>
                <span class="font-medium">Choose Files</span>
                <input type="file" 
                       multiple 
                       accept="audio/*"
                       class="hidden"
                       data-action="change->release-wizard#handleTrackUpload" />
              </label>
              <p class="text-sm text-gray-500 mt-3">
                or drag and drop audio files here
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Uploaded Tracks List -->
      <div class="mb-8">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-lg font-medium text-music-text">Uploaded Tracks</h3>
          <% if @release.release_type == 'single' %>
            <span class="text-sm text-gray-500">Max 1 track</span>
          <% else %>
            <span class="text-sm text-gray-500">
              Min <%= @track_requirements[:min] %> track<%= @track_requirements[:min] > 1 ? 's' : '' %>
              <% if @track_requirements[:max] %>
                , Max <%= @track_requirements[:max] %> tracks
              <% end %>
            </span>
          <% end %>
        </div>
        <div class="space-y-4" data-release-wizard-target="trackList">
          <% if @tracks.any? %>
            <% @tracks.each_with_index do |track, index| %>
              <div class="track-item bg-gray-50 p-4 rounded-lg border border-gray-200" data-track-index="<%= index %>">
                <div class="flex items-center justify-between mb-2">
                  <div class="flex items-center gap-3">
                    <span class="text-sm font-medium text-gray-500 bg-white px-2 py-1 rounded">#<%= track.position %></span>
                    <div>
                      <h4 class="font-medium text-gray-900"><%= track.title %></h4>
                      <% if track.duration.present? %>
                        <p class="text-sm text-gray-500">Duration: <%= Time.at(track.duration).utc.strftime("%M:%S") %></p>
                      <% end %>
                    </div>
                  </div>
                  <%= link_to release_track_path(@release, track), 
                            method: :delete,
                            data: { turbo_confirm: "Are you sure?" },
                            class: "text-red-500 hover:text-red-700" do %>
                    <i class="fas fa-trash text-sm"></i>
                  <% end %>
                </div>
                <div class="mb-2">
                  <%= text_field_tag "tracks[#{index}][title]", track.title,
                                   class: "w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-teal-500",
                                   placeholder: "Track title" %>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2">
                  <div class="bg-green-600 h-2 rounded-full track-progress" style="width: 100%"></div>
                </div>
                <p class="text-xs text-green-600 mt-1">Upload complete</p>
              </div>
            <% end %>
          <% else %>
            <div class="text-center py-8 text-gray-500">
              <i class="fas fa-music text-3xl mb-4 opacity-50"></i>
              <p>No tracks uploaded yet</p>
              <p class="text-sm">Use the upload area above to add your audio files</p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Navigation -->
      <div class="flex justify-between items-center pt-6 border-t border-music-border">
        <%= link_to "Back", step2_release_wizard_path(@release), 
                    class: "px-6 py-3 border border-music-border rounded-md text-music-text hover:bg-music-background transition-colors" %>
        
        <button type="button" 
                data-release-wizard-target="continueBtn"
                data-action="click->release-wizard#goNext"
                class="px-6 py-3 bg-teal-600 text-white rounded-md font-medium hover:bg-teal-700 focus:outline-none focus:ring-2 focus:ring-teal-500 transition-colors opacity-50 cursor-not-allowed"
                disabled>
          Upload & Continue
        </button>
      </div>
    </div>
  </div>
</div>
