<div class="min-h-screen bg-music-background py-8">
  <div class="max-w-4xl mx-auto px-4">
    <!-- Enhanced Progress Bar -->
    <div class="mb-12">
      <div class="flex items-center justify-center mb-4">
        <div class="flex items-center space-x-2 md:space-x-4">
          <!-- Step 1 -->
          <div class="flex flex-col items-center">
            <div class="w-10 h-10 <%= @edit_mode ? 'bg-music-surface text-music-text-secondary border-2 border-music-border' : 'bg-music-primary text-music-background border-2 border-music-primary' %> rounded-full flex items-center justify-center text-sm font-bold">
              <% if @edit_mode %>
                <i class="fas fa-lock text-xs"></i>
              <% else %>
                <i class="fas fa-check text-xs"></i>
              <% end %>
            </div>
            <span class="mt-2 text-sm font-medium <%= @edit_mode ? 'text-music-text-secondary' : 'text-music-primary' %>">
              <%= @edit_mode ? "Type Locked" : "Select Type" %>
            </span>
          </div>
          
          <div class="w-16 h-1 bg-music-primary rounded-full"></div>

          <!-- Step 2 -->
          <div class="flex flex-col items-center">
            <div class="w-10 h-10 bg-music-primary text-music-background rounded-full flex items-center justify-center text-sm font-bold border-2 border-music-primary">
              <i class="fas fa-check text-xs"></i>
            </div>
            <span class="mt-2 text-sm font-medium text-music-primary">Release Info</span>
          </div>
          
          <div class="w-16 h-1 bg-music-primary rounded-full"></div>

          <!-- Step 3 -->
          <div class="flex flex-col items-center">
            <div class="w-10 h-10 bg-music-primary text-music-background rounded-full flex items-center justify-center text-sm font-bold border-2 border-music-primary">
              3
            </div>
            <span class="mt-2 text-sm font-medium text-music-text">
              <%= @edit_mode ? "Edit Tracks" : "Upload Tracks" %>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content Card -->
    <div class="bg-music-surface rounded-genre shadow-genre border border-music-border/50 p-8 backdrop-blur-sm bg-opacity-90"
         data-controller="release-wizard" 
         data-release-wizard-step-value="3"
         data-release-wizard-selected-type-value="<%= @release.release_type %>"
         data-release-wizard-track-requirements-value="<%= @track_requirements.to_json %>"
         data-release-wizard-base-url-value="<%= release_wizard_path(@release.id) %>"
         data-release-wizard-update-url-value="<%= update_step_release_wizard_path(@release.id) %>"
         data-release-wizard-edit-mode-value="<%= @edit_mode || false %>">
      
      <!-- Header -->
      <div class="text-center mb-10">
        <h1 class="text-3xl font-display tracking-tight text-music-text mb-3">
          <%= @edit_mode ? "Edit Your Tracks" : "Upload Your Tracks" %>
        </h1>
        <div class="w-20 h-1 bg-music-primary mx-auto mb-4"></div>
        <p class="text-music-text-secondary text-lg mb-6">
          <%= @edit_mode ? "Manage tracks in your" : "Add tracks to your" %> <%= @release.release_type.titleize.downcase %>
        </p>
        <div class="inline-flex items-center px-4 py-2 bg-music-primary/10 border border-music-primary/20 rounded-genre text-music-primary">
          <i class="fas fa-info-circle mr-2"></i>
          <span class="text-sm">
            <%= @track_requirements[:description] %>
          </span>
        </div>
      </div>

      <% if flash[:alert] %>
        <div class="mb-6 p-4 bg-red-500/10 border border-red-500/30 rounded-genre text-red-400">
          <i class="fas fa-exclamation-circle mr-2"></i>
          <%= flash[:alert] %>
        </div>
      <% end %>

      <!-- Track Upload Section -->
      <div class="mb-10" data-release-wizard-target="trackUpload">
        <div class="border-2 border-dashed border-music-border/50 rounded-genre p-8 text-center bg-music-background/20 hover:border-music-primary hover:bg-music-primary/10 transition-all duration-300 cursor-pointer group"
             data-action="dragover->release-wizard#highlight dragleave->release-wizard#unhighlight drop->release-wizard#drop click->release-wizard#triggerFileInput">
          <div class="upload-container">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-music-surface rounded-full mb-4 group-hover:bg-music-primary/10 transition-colors">
              <i class="fas fa-music text-music-text-secondary/50 text-3xl group-hover:text-music-primary transition-colors"></i>
            </div>
            <h3 class="text-lg font-medium text-music-text mb-2">Upload Audio Files</h3>
            <p class="text-music-text-secondary/70 upload-description mb-6">
              <%= @track_requirements[:description] %>
            </p>
            <div class="max-w-sm mx-auto bg-music-surface rounded-genre border border-music-border/50 p-4 mb-6">
              <div class="text-sm text-left">
                <h4 class="font-medium text-music-text mb-3">Supported Formats:</h4>
                <div class="grid grid-cols-2 gap-3">
                  <div class="flex items-center text-music-text-secondary/80">
                    <i class="fas fa-check text-music-primary mr-2 text-xs"></i>
                    <span>WAV, FLAC</span>
                  </div>
                  <div class="flex items-center text-music-text-secondary/80">
                    <i class="fas fa-check text-music-primary mr-2 text-xs"></i>
                    <span>AIFF, ALAC</span>
                  </div>
                  <div class="flex items-center text-music-text-secondary/80">
                    <i class="fas fa-check text-music-primary mr-2 text-xs"></i>
                    <span>MP3, AAC</span>
                  </div>
                  <div class="flex items-center text-music-text-secondary/80">
                    <i class="fas fa-check text-music-primary mr-2 text-xs"></i>
                    <span>Max 100MB</span>
                  </div>
                </div>
              </div>
            </div>
            <div class="flex flex-col items-center">
              <label class="inline-flex items-center px-8 py-3 bg-music-primary text-music-background rounded-button cursor-pointer hover:bg-music-primary/90 transition-colors shadow-button hover:shadow-genre-hover">
                <i class="fas fa-upload mr-2"></i>
                <span class="font-medium tracking-wider">CHOOSE FILES</span>
                <input type="file" 
                       multiple 
                       accept="audio/*"
                       class="hidden"
                       data-action="change->release-wizard#handleTrackUpload" />
              </label>
              <p class="text-sm text-music-text-secondary/50 mt-3">
                or drag and drop audio files here
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Uploaded Tracks List -->
      <div class="mb-10">
        <div class="flex items-center justify-between mb-6">
          <h3 class="text-xl font-display tracking-tight text-music-text">Uploaded Tracks</h3>
          <% if @release.release_type == 'single' %>
            <span class="text-sm text-music-text-secondary/70">Max 1 track</span>
          <% else %>
            <span class="text-sm text-music-text-secondary/70">
              Min <%= @track_requirements[:min] %> track<%= @track_requirements[:min] > 1 ? 's' : '' %>
              <% if @track_requirements[:max] %>
                , Max <%= @track_requirements[:max] %> tracks
              <% end %>
            </span>
          <% end %>
        </div>
        <div class="space-y-4" data-release-wizard-target="trackList">
          <% if @tracks.any? %>
            <% @tracks.each_with_index do |track, index| %>
              <div class="track-item bg-music-surface border border-music-border/50 rounded-genre p-5 hover:bg-music-background/30 transition-colors" data-track-index="<%= index %>">
                <div class="flex items-center justify-between mb-3">
                  <div class="flex items-center gap-4">
                    <span class="text-sm font-medium text-music-text bg-music-background/50 px-3 py-1 rounded-full border border-music-border/30">
                      #<%= track.position %>
                    </span>
                    <div>
                      <h4 class="font-medium text-music-text"><%= track.title %></h4>
                      <% if track.duration.present? %>
                        <p class="text-sm text-music-text-secondary">Duration: <%= Time.at(track.duration).utc.strftime("%M:%S") %></p>
                      <% end %>
                    </div>
                  </div>
                  <%= link_to release_track_path(@release, track), 
                            method: :delete,
                            data: { turbo_confirm: "Are you sure you want to delete this track?" },
                            class: "text-music-primary hover:text-music-accent transition-colors" do %>
                    <i class="fas fa-trash"></i>
                  <% end %>
                </div>
                <div class="mb-3">
                  <%= text_field_tag "tracks[#{index}][title]", track.title,
                                   class: "w-full px-4 py-2 border border-music-border/50 rounded-genre bg-music-background/20 text-music-text focus:outline-none focus:ring-2 focus:ring-music-primary focus:border-music-primary transition-all",
                                   placeholder: "Track title" %>
                </div>
                <div class="w-full bg-music-border/50 rounded-full h-1.5">
                  <div class="bg-music-primary h-1.5 rounded-full track-progress" style="width: 100%"></div>
                </div>
                <p class="text-xs text-music-primary mt-2 flex items-center">
                  <i class="fas fa-check-circle mr-1"></i>
                  Upload complete
                </p>
              </div>
            <% end %>
          <% else %>
            <div class="text-center py-12 text-music-text-secondary/50">
              <i class="fas fa-music text-4xl mb-4 opacity-50"></i>
              <p class="text-lg mb-1">No tracks uploaded yet</p>
              <p class="text-sm">Use the upload area above to add your audio files</p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Navigation -->
      <div class="flex justify-between items-center pt-8 border-t border-music-border/30">
        <% if @edit_mode %>
          <%= link_to edit_step2_release_wizard_path(@release), 
                      class: "px-6 py-3 border border-music-border/50 rounded-genre text-music-text hover:bg-music-background/20 hover:border-music-primary transition-all flex items-center" do %>
            <i class="fas fa-arrow-left mr-2"></i>
            Back to Release Info
          <% end %>
        <% else %>
          <%= link_to step2_release_wizard_path(@release), 
                      class: "px-6 py-3 border border-music-border/50 rounded-genre text-music-text hover:bg-music-background/20 hover:border-music-primary transition-all flex items-center" do %>
            <i class="fas fa-arrow-left mr-2"></i>
            Back
          <% end %>
        <% end %>
        
        <button type="button" 
                data-release-wizard-target="continueBtn"
                data-action="click->release-wizard#goNext"
                class="px-8 py-3 bg-music-primary hover:bg-music-primary/90 text-music-background rounded-button font-display tracking-wider text-lg transition-all duration-300 shadow-button hover:shadow-genre-hover disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:shadow-button"
                disabled>
          <%= @edit_mode ? "SAVE CHANGES" : "UPLOAD & CONTINUE" %>
        </button>
      </div>
    </div>
  </div>
</div>