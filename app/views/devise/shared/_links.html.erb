<div class="space-y-3 text-center">
  <% if controller_name != 'sessions' %>
    <%= link_to "Sign In", new_session_path(resource_name), 
          class: "block text-music-primary hover:text-music-primary/80 font-medium transition-colors duration-200" %>
  <% end %>

  <% if devise_mapping.registerable? && controller_name != 'registrations' %>
    <%= link_to "Create Account", new_registration_path(resource_name), 
          class: "block text-music-secondary hover:text-music-secondary/80 font-medium transition-colors duration-200" %>
  <% end %>

  <% if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <%= link_to "Forgot Password?", new_password_path(resource_name), 
          class: "block text-music-text-secondary hover:text-music-text transition-colors duration-200" %>
  <% end %>

  <% if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <%= link_to "Didn't receive confirmation instructions?", new_confirmation_path(resource_name), 
          class: "block text-music-text-secondary hover:text-music-text transition-colors duration-200" %>
  <% end %>

  <% if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <%= link_to "Didn't receive unlock instructions?", new_unlock_path(resource_name), 
          class: "block text-music-text-secondary hover:text-music-text transition-colors duration-200" %>
  <% end %>

  <% if devise_mapping.omniauthable? %>
    <div class="mt-6 space-y-3">
      <div class="relative">
        <div class="absolute inset-0 flex items-center">
          <div class="w-full border-t border-music-text-secondary/30"></div>
        </div>
        <div class="relative flex justify-center text-sm">
          <span class="px-2 bg-music-surface text-music-text-secondary">Or continue with</span>
        </div>
      </div>
      <% resource_class.omniauth_providers.each do |provider| %>
        <%= button_to omniauth_authorize_path(resource_name, provider), 
              data: { turbo: false }, 
              class: "w-full flex items-center justify-center bg-music-surface border border-music-text-secondary/30 text-music-text py-3 px-4 rounded-button hover:bg-music-background focus:outline-none focus:ring-2 focus:ring-music-primary transition-all duration-200" do %>
          <% if provider.to_s == 'google_oauth2' %>
            <svg class="h-5 w-5 mr-3" version="1.1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48">
              <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"></path>
              <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"></path>
              <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"></path>
              <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"></path>
            </svg>
            Sign in with <%= OmniAuth::Utils.camelize(provider) %>
          <% else %>
            <i class="fas fa-sign-in-alt mr-3"></i>
            Sign in with <%= OmniAuth::Utils.camelize(provider) %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
