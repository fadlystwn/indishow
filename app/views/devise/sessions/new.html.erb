<div class="flex items-center justify-center min-h-screen bg-music-background">
  <div class="w-full max-w-md p-8 bg-music-surface rounded-genre shadow-genre">
    <div class="text-center mb-8">
      <i class="fas fa-music text-4xl text-music-primary mb-4"></i>
      <h2 class="text-3xl font-display font-bold text-music-text">Welcome Back</h2>
      <p class="text-music-text-secondary mt-2">Sign in to your account</p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="mb-6">
        <%= f.label :email, class: "block text-sm font-medium text-music-text mb-2" %>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <i class="fas fa-envelope text-music-text-secondary"></i>
          </div>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", 
                class: "block w-full pl-10 pr-3 py-3 bg-music-background border border-music-text-secondary/30 rounded-button text-music-text placeholder-music-text-secondary focus:outline-none focus:ring-2 focus:ring-music-primary focus:border-music-primary transition-colors duration-200",
                placeholder: "your@email.com" %>
        </div>
      </div>

      <div class="mb-6">
        <%= f.label :password, class: "block text-sm font-medium text-music-text mb-2" %>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <i class="fas fa-lock text-music-text-secondary"></i>
          </div>
          <%= f.password_field :password, autocomplete: "current-password", 
                class: "block w-full pl-10 pr-3 py-3 bg-music-background border border-music-text-secondary/30 rounded-button text-music-text placeholder-music-text-secondary focus:outline-none focus:ring-2 focus:ring-music-primary focus:border-music-primary transition-colors duration-200",
                placeholder: "Enter your password" %>
        </div>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="mb-6 flex items-center">
          <%= f.check_box :remember_me, class: "h-4 w-4 text-music-primary focus:ring-music-primary border-music-text-secondary/30 rounded bg-music-background" %>
          <%= f.label :remember_me, class: "ml-2 text-sm text-music-text-secondary" %>
        </div>
      <% end %>

      <div class="mb-6">
        <%= f.submit "Sign In", class: "w-full py-3 px-4 bg-music-primary text-white font-semibold rounded-button shadow-button hover:bg-music-primary/90 focus:outline-none focus:ring-2 focus:ring-music-primary focus:ring-opacity-50 transition-all duration-200 transform hover:scale-[1.02]" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
