<div class="flex items-center justify-center min-h-screen bg-music-background">
  <div class="w-full max-w-md p-8 bg-music-surface rounded-genre shadow-genre">
    <div class="text-center mb-8">
      <i class="fas fa-key text-4xl text-music-accent mb-4"></i>
      <h2 class="text-3xl font-display font-bold text-music-text">Reset Password</h2>
      <p class="text-music-text-secondary mt-2">Enter your email to receive reset instructions</p>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-6" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.label :email, class: "block text-sm font-medium text-music-text mb-2" %>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <i class="fas fa-envelope text-music-text-secondary"></i>
          </div>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", 
                class: "block w-full pl-10 pr-3 py-3 bg-music-background border border-music-text-secondary/30 rounded-button text-music-text placeholder-music-text-secondary focus:outline-none focus:ring-2 focus:ring-music-accent focus:border-music-accent transition-colors duration-200",
                placeholder: "your@email.com" %>
        </div>
      </div>

      <div>
        <%= f.submit "Send Reset Instructions", 
              class: "w-full py-3 px-4 bg-music-accent text-music-background font-semibold rounded-button shadow-button hover:bg-music-accent/90 focus:outline-none focus:ring-2 focus:ring-music-accent focus:ring-opacity-50 transition-all duration-200 transform hover:scale-[1.02]" %>
      </div>
    <% end %>

    <div class="mt-6 text-center">
     <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
