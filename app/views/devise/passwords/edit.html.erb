<div class="flex items-center justify-center min-h-screen bg-music-background">
  <div class="w-full max-w-md p-8 bg-music-surface rounded-genre shadow-genre">
    <div class="text-center mb-8">
      <i class="fas fa-lock text-4xl text-music-primary mb-4"></i>
      <h2 class="text-3xl font-display font-bold text-music-text">New Password</h2>
      <p class="text-music-text-secondary mt-2">Enter your new password below</p>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-6" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div>
        <div class="flex justify-between items-center">
          <%= f.label :password, "New password", class: "block text-sm font-medium text-music-text" %>
          <% if @minimum_password_length %>
            <span class="text-xs text-music-text-secondary">(<%= @minimum_password_length %> characters minimum)</span>
          <% end %>
        </div>
        <div class="relative mt-2">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <i class="fas fa-lock text-music-text-secondary"></i>
          </div>
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password", 
                class: "block w-full pl-10 pr-3 py-3 bg-music-background border border-music-text-secondary/30 rounded-button text-music-text placeholder-music-text-secondary focus:outline-none focus:ring-2 focus:ring-music-primary focus:border-music-primary transition-colors duration-200",
                placeholder: "••••••••" %>
        </div>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirm new password", class: "block text-sm font-medium text-music-text mb-2" %>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <i class="fas fa-lock text-music-text-secondary"></i>
          </div>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", 
                class: "block w-full pl-10 pr-3 py-3 bg-music-background border border-music-text-secondary/30 rounded-button text-music-text placeholder-music-text-secondary focus:outline-none focus:ring-2 focus:ring-music-primary focus:border-music-primary transition-colors duration-200",
                placeholder: "••••••••" %>
        </div>
      </div>

      <div>
        <%= f.submit "Change Password", 
              class: "w-full py-3 px-4 bg-music-primary text-white font-semibold rounded-button shadow-button hover:bg-music-primary/90 focus:outline-none focus:ring-2 focus:ring-music-primary focus:ring-opacity-50 transition-all duration-200 transform hover:scale-[1.02]" %>
      </div>
    <% end %>

    <div class="mt-6 text-center">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
