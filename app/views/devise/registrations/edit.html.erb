<div class="max-w-md mx-auto mt-10">
  <h2 class="text-2xl font-bold mb-6">Edit Profile</h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <!-- Email Field -->
    <div class="field">
      <%= f.label :email, class: "block text-sm font-medium text-gray-700" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
    </div>

    <!-- Password Fields -->
    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <div class="text-sm text-yellow-600">
        Currently waiting confirmation for: <%= resource.unconfirmed_email %>
      </div>
    <% end %>

    <div class="field">
      <%= f.label :password, "New password", class: "block text-sm font-medium text-gray-700" %>
      <%= f.password_field :password, autocomplete: "new-password", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
      <p class="text-xs text-gray-500 mt-1">Leave blank if you don't want to change it</p>
    </div>

    <div class="field">
      <%= f.label :password_confirmation, class: "block text-sm font-medium text-gray-700" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
    </div>

    <!-- Current Password -->
    <div class="field">
      <%= f.label :current_password, class: "block text-sm font-medium text-gray-700" %>
      <%= f.password_field :current_password, autocomplete: "current-password", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
      <p class="text-xs text-gray-500 mt-1">We need your current password to confirm your changes</p>
    </div>

    <!-- Profile Fields -->
    <%= f.fields_for :profile do |pf| %>
      <div class="border-t pt-4 mt-4">
        <h3 class="text-lg font-medium mb-4">Profile Information</h3>

        <!-- Name Field -->
        <div class="field">
          <%= pf.label :name, "Display Name", class: "block text-sm font-medium text-gray-700" %>
          <%= pf.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
        </div>

        <!-- Role-Specific Fields -->
        <% if resource.artist? %>
          <!-- Artist Fields -->
          <div class="field">
            <%= pf.label :bio, class: "block text-sm font-medium text-gray-700" %>
            <%= pf.text_area :bio, rows: 3, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
          </div>

          <div class="field">
            <%= pf.label :website_url, "Website", class: "block text-sm font-medium text-gray-700" %>
            <%= pf.text_field :website_url, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
          </div>

          <div class="field">
            <%= pf.label :location, class: "block text-sm font-medium text-gray-700" %>
            <%= pf.text_field :location, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
          </div>

          <div class="field">
            <%= pf.label :avatar, class: "block text-sm font-medium text-gray-700" %>
            <%= pf.file_field :avatar, class: "mt-1 block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" %>
            <% if pf.object.avatar.attached? %>
              <div class="mt-2">
                <%= image_tag pf.object.avatar, class: "h-20 w-20 rounded-full object-cover" %>
                <%= label_tag :remove_avatar, class: "flex items-center mt-2 text-sm text-gray-700" do %>
                  <%= check_box_tag :remove_avatar %> Remove avatar
                <% end %>
              </div>
            <% end %>
          </div>

        <% else %>
          <!-- Fan Fields -->
          <div class="field">
            <%= pf.label :favorite_genres, "Favorite Genres", class: "block text-sm font-medium text-gray-700" %>
            <%= pf.text_field :favorite_genres, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- Submit Button -->
    <div class="actions pt-4">
      <%= f.submit "Update", class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
    </div>
  <% end %>

  <div class="mt-6 pt-6 border-t">
    <h3 class="text-lg font-medium mb-4">Cancel my account</h3>
    <p class="text-sm text-gray-600 mb-2">Unhappy with your account?</p>
    <%= button_to "Cancel my account", registration_path(resource_name), 
          data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" }, 
          method: :delete, 
          class: "text-sm text-red-600 hover:text-red-800" %>
  </div>
</div>