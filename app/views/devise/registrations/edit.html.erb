<div class="min-h-screen bg-music-background py-12">
  <div class="max-w-5xl mx-auto bg-music-surface rounded-genre shadow-genre overflow-hidden p-8">
    <div class="text-center mb-8">
      <i class="fas fa-user-edit text-4xl text-music-primary mb-4"></i>
      <h2 class="text-3xl font-display font-bold text-music-text">Edit Profile</h2>
      <p class="text-music-text-secondary mt-2">Update your account and profile information</p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-8" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
        <!-- Left Column - Account Settings -->
        <div class="space-y-6">
          <div class="bg-music-background p-6 rounded-genre border border-music-text-secondary/20">
            <h3 class="text-lg font-medium text-music-text mb-4 flex items-center">
              <i class="fas fa-lock text-music-text-secondary mr-2"></i>
              Account Settings
            </h3>

            <!-- Email Field -->
            <div class="field">
              <%= f.label :email, class: "block text-sm font-medium text-music-text mb-2" %>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <i class="fas fa-envelope text-music-text-secondary"></i>
                </div>
                <%= f.email_field :email, autofocus: true, autocomplete: "email", 
                      class: "pl-10 block w-full py-3 bg-music-surface border border-music-text-secondary/30 rounded-button text-music-text focus:outline-none focus:ring-2 focus:ring-music-primary focus:border-music-primary transition-colors duration-200" %>
              </div>
            </div>

            <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
              <div class="mt-4 p-3 bg-yellow-900/30 border border-yellow-600/50 rounded-button text-sm text-yellow-300 flex items-start">
                <i class="fas fa-exclamation-triangle text-yellow-400 mr-2 mt-0.5"></i>
                <span>Currently waiting confirmation for: <span class="font-medium"><%= resource.unconfirmed_email %></span></span>
              </div>
            <% end %>
          </div>

          <div class="bg-music-background p-6 rounded-genre border border-music-text-secondary/20">
            <h3 class="text-lg font-medium text-music-text mb-4 flex items-center">
              <i class="fas fa-key text-music-text-secondary mr-2"></i>
              Change Password
            </h3>

            <div class="space-y-4">
              <div class="field">
                <%= f.label :password, "New password", class: "block text-sm font-medium text-music-text mb-2" %>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i class="fas fa-lock text-music-text-secondary"></i>
                  </div>
                  <%= f.password_field :password, autocomplete: "new-password", 
                        class: "pl-10 block w-full py-3 bg-music-surface border border-music-text-secondary/30 rounded-button text-music-text focus:outline-none focus:ring-2 focus:ring-music-primary focus:border-music-primary transition-colors duration-200" %>
                </div>
                <p class="mt-1 text-xs text-music-text-secondary">Leave blank if you don't want to change it</p>
              </div>

              <div class="field">
                <%= f.label :password_confirmation, class: "block text-sm font-medium text-music-text mb-2" %>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i class="fas fa-lock text-music-text-secondary"></i>
                  </div>
                  <%= f.password_field :password_confirmation, autocomplete: "new-password", 
                        class: "pl-10 block w-full py-3 bg-music-surface border border-music-text-secondary/30 rounded-button text-music-text focus:outline-none focus:ring-2 focus:ring-music-primary focus:border-music-primary transition-colors duration-200" %>
                </div>
              </div>

              <div class="field">
                <%= f.label :current_password, class: "block text-sm font-medium text-music-text mb-2" %>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i class="fas fa-key text-music-text-secondary"></i>
                  </div>
                  <%= f.password_field :current_password, autocomplete: "current-password", 
                        class: "pl-10 block w-full py-3 bg-music-surface border border-music-text-secondary/30 rounded-button text-music-text focus:outline-none focus:ring-2 focus:ring-music-primary focus:border-music-primary transition-colors duration-200" %>
                </div>
                <p class="mt-1 text-xs text-music-text-secondary">We need your current password to confirm your changes</p>
              </div>
          </div>
        </div>
      </div>

        <!-- Right Column - Profile Information -->
        <div class="space-y-6">
          <%= f.fields_for :profile do |pf| %>
            <div class="bg-music-background p-6 rounded-genre border border-music-text-secondary/20">
              <h3 class="text-lg font-medium text-music-text mb-4 flex items-center">
                <i class="fas fa-user text-music-text-secondary mr-2"></i>
                Profile Information
              </h3>

              <div class="space-y-4">
                <div class="field">
                  <%= pf.label :name, "Display Name", class: "block text-sm font-medium text-music-text mb-2" %>
                  <%= pf.text_field :name, 
                        class: "block w-full py-3 px-3 bg-music-surface border border-music-text-secondary/30 rounded-button text-music-text focus:outline-none focus:ring-2 focus:ring-music-primary focus:border-music-primary transition-colors duration-200" %>
                </div>

                <% if resource.artist? %>
                  <!-- Artist Fields -->
                  <div class="field">
                    <%= pf.label :bio, class: "block text-sm font-medium text-music-text mb-2" %>
                    <%= pf.text_area :bio, rows: 3, 
                          class: "block w-full py-3 px-3 bg-music-surface border border-music-text-secondary/30 rounded-button text-music-text focus:outline-none focus:ring-2 focus:ring-music-primary focus:border-music-primary transition-colors duration-200" %>
                  </div>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="field">
                      <%= pf.label :website_url, "Website", class: "block text-sm font-medium text-music-text mb-2" %>
                      <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                          <i class="fas fa-link text-music-text-secondary"></i>
                        </div>
                        <%= pf.text_field :website_url, 
                              class: "pl-10 block w-full py-3 bg-music-surface border border-music-text-secondary/30 rounded-button text-music-text focus:outline-none focus:ring-2 focus:ring-music-primary focus:border-music-primary transition-colors duration-200" %>
                      </div>
                    </div>

                    <div class="field">
                      <%= pf.label :location, class: "block text-sm font-medium text-music-text mb-2" %>
                      <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                          <i class="fas fa-map-marker-alt text-music-text-secondary"></i>
                        </div>
                        <%= pf.text_field :location, 
                              class: "pl-10 block w-full py-3 bg-music-surface border border-music-text-secondary/30 rounded-button text-music-text focus:outline-none focus:ring-2 focus:ring-music-primary focus:border-music-primary transition-colors duration-200" %>
                      </div>
                    </div>
                  </div>

                  <div class="field">
                    <%= pf.label :avatar, class: "block text-sm font-medium text-music-text mb-2" %>
                    <div class="mt-1 flex items-center" data-controller="avatar-upload">
                      <div data-avatar-upload-target="preview" class="flex-shrink-0">
                        <% if pf.object.persisted? && pf.object.avatar.attached? %>
                          <%= image_tag pf.object.avatar, class: "h-16 w-16 rounded-full object-cover border-2 border-music-primary" %>
                        <% else %>
                          <div class="h-16 w-16 rounded-full bg-music-surface border-2 border-music-text-secondary/30 flex items-center justify-center text-music-text-secondary">
                            <i class="fas fa-user text-2xl"></i>
                          </div>
                        <% end %>
                      </div>
                      <div class="ml-4 flex items-center space-x-4">
                        <label class="cursor-pointer">
                          <span class="rounded-button bg-music-secondary text-white py-2 px-4 text-sm font-medium hover:bg-music-secondary/90 focus:outline-none focus:ring-2 focus:ring-music-secondary transition-colors duration-200">
                            Change
                            <%= file_field_tag "user[profile_attributes][avatar]", 
                                class: "sr-only",
                                data: { 
                                  avatar_upload_target: "input"
                                } %>
                          </span>
                        </label>
                        <% if pf.object.persisted? && pf.object.avatar.attached? %>
                          <div>
                            <%= label_tag :remove_avatar, class: "flex items-center text-sm text-music-text" do %>
                              <%= check_box_tag :remove_avatar, 
                                  "1", 
                                  false, 
                                  class: "h-4 w-4 text-music-primary focus:ring-music-primary border-music-text-secondary/30 rounded bg-music-surface",
                                  data: { 
                                    avatar_upload_target: "removeCheckbox",
                                    action: "change->avatar-upload#removeAvatar"
                                  } %>
                              <span class="ml-2">Remove</span>
                            <% end %>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  </div>

                <% else %>
                  <!-- Fan Fields -->
                  <div class="field">
                    <%= pf.label :favorite_genres, "Favorite Genres", class: "block text-sm font-medium text-music-text mb-2" %>
                    <div class="relative">
                      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i class="fas fa-music text-music-text-secondary"></i>
                      </div>
                      <%= pf.text_field :favorite_genres, 
                            class: "pl-10 block w-full py-3 bg-music-surface border border-music-text-secondary/30 rounded-button text-music-text focus:outline-none focus:ring-2 focus:ring-music-primary focus:border-music-primary transition-colors duration-200" %>
                    </div>
                    <p class="mt-1 text-xs text-music-text-secondary">Separate genres with commas</p>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
    </div>

    <!-- Submit Button -->
    <div class="pt-6">
      <%= f.submit "Update Profile", class: "w-full flex justify-center items-center py-3 px-4 border border-transparent rounded-button shadow-button text-sm font-medium text-white bg-music-primary hover:bg-music-primary/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-music-primary transition-colors duration-200" %>
    </div>
  <% end %>

  <!-- Danger Zone -->
  <div class="mt-8 pt-8 border-t border-music-text-secondary/20">
    <div class="bg-red-900/20 border border-red-600/30 p-6 rounded-genre">
      <h3 class="text-lg font-medium text-red-400 mb-3 flex items-center">
        <i class="fas fa-exclamation-triangle text-red-500 mr-2"></i>
        Danger Zone
      </h3>
      <p class="text-sm text-red-300 mb-4">Once you delete your account, there is no going back. Please be certain.</p>
      <%= button_to "Delete my account", registration_path(resource_name), 
            data: { confirm: "Are you sure you want to delete your account? This action cannot be undone.", turbo_confirm: "Are you sure you want to delete your account? This action cannot be undone." }, 
            method: :delete, 
            class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-button shadow-button text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors duration-200" %>
    </div>
  </div>
</div>