<div class="max-w-5xl mx-auto mt-10 bg-white rounded-xl shadow-md overflow-hidden p-8">
  <h2 class="text-2xl font-bold text-gray-800 mb-8 text-center">Edit Profile</h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-8" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
      <!-- Left Column - Account Settings -->
      <div class="space-y-6">
        <div class="bg-gray-50 p-6 rounded-lg">
          <h3 class="text-lg font-medium text-gray-900 mb-4 flex items-center">
            <svg class="h-5 w-5 text-gray-500 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            Account Settings
          </h3>

          <!-- Email Field -->
          <div class="field">
            <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <div class="relative mt-1">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
                  <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
                </svg>
              </div>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "pl-10 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 py-2" %>
            </div>
          </div>

          <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
            <div class="mt-4 p-3 bg-yellow-50 rounded-md text-sm text-yellow-700 flex items-start">
              <svg class="h-5 w-5 text-yellow-400 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
              </svg>
              <span>Currently waiting confirmation for: <span class="font-medium"><%= resource.unconfirmed_email %></span></span>
            </div>
          <% end %>
        </div>

        <div class="bg-gray-50 p-6 rounded-lg">
          <h3 class="text-lg font-medium text-gray-900 mb-4 flex items-center">
            <svg class="h-5 w-5 text-gray-500 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
            </svg>
            Change Password
          </h3>

          <div class="space-y-4">
            <div class="field">
              <%= f.label :password, "New password", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <div class="relative mt-1">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
                  </svg>
                </div>
                <%= f.password_field :password, autocomplete: "new-password", class: "pl-10 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 py-2" %>
              </div>
              <p class="mt-1 text-xs text-gray-500">Leave blank if you don't want to change it</p>
            </div>

            <div class="field">
              <%= f.label :password_confirmation, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <div class="relative mt-1">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
                  </svg>
                </div>
                <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "pl-10 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 py-2" %>
              </div>
            </div>

            <div class="field">
              <%= f.label :current_password, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <div class="relative mt-1">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
                  </svg>
                </div>
                <%= f.password_field :current_password, autocomplete: "current-password", class: "pl-10 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 py-2" %>
              </div>
              <p class="mt-1 text-xs text-gray-500">We need your current password to confirm your changes</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column - Profile Information -->
      <div class="space-y-6">
        <%= f.fields_for :profile do |pf| %>
          <div class="bg-gray-50 p-6 rounded-lg">
            <h3 class="text-lg font-medium text-gray-900 mb-4 flex items-center">
              <svg class="h-5 w-5 text-gray-500 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              Profile Information
            </h3>

            <div class="space-y-4">
              <div class="field">
                <%= pf.label :name, "Display Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= pf.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 py-2 px-3" %>
              </div>

              <% if resource.artist? %>
                <!-- Artist Fields -->
                <div class="field">
                  <%= pf.label :bio, class: "block text-sm font-medium text-gray-700 mb-1" %>
                  <%= pf.text_area :bio, rows: 3, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 py-2 px-3" %>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div class="field">
                    <%= pf.label :website_url, "Website", class: "block text-sm font-medium text-gray-700 mb-1" %>
                    <div class="relative mt-1">
                      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M12.586 4.586a2 2 0 112.828 2.828l-3 3a2 2 0 01-2.828 0 1 1 0 00-1.414 1.414 4 4 0 005.656 0l3-3a4 4 0 00-5.656-5.656l-1.5 1.5a1 1 0 101.414 1.414l1.5-1.5zm-5 5a2 2 0 012.828 0 1 1 0 101.414-1.414 4 4 0 00-5.656 0l-3 3a4 4 0 105.656 5.656l1.5-1.5a1 1 0 10-1.414-1.414l-1.5 1.5a2 2 0 11-2.828-2.828l3-3z" clip-rule="evenodd" />
                        </svg>
                      </div>
                      <%= pf.text_field :website_url, class: "pl-10 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 py-2" %>
                    </div>
                  </div>

                  <div class="field">
                    <%= pf.label :location, class: "block text-sm font-medium text-gray-700 mb-1" %>
                    <div class="relative mt-1">
                      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                        </svg>
                      </div>
                      <%= pf.text_field :location, class: "pl-10 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 py-2" %>
                    </div>
                  </div>
                </div>

                <div class="field">
                  <%= pf.label :avatar, class: "block text-sm font-medium text-gray-700 mb-2" %>
                  <div class="mt-1 flex items-center" data-controller="avatar-upload">
                    <div data-avatar-upload-target="preview" class="flex-shrink-0">
                      <% if pf.object.persisted? && pf.object.avatar.attached? %>
                        <%= image_tag pf.object.avatar, class: "h-16 w-16 rounded-full object-cover" %>
                      <% else %>
                        <div class="h-16 w-16 rounded-full bg-gray-200 flex items-center justify-center text-gray-500">
                          <svg class="h-8 w-8" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                          </svg>
                        </div>
                      <% end %>
                    </div>
                    <div class="ml-4 flex items-center space-x-4">
                      <label class="cursor-pointer">
                        <span class="rounded-md bg-white py-2 px-3 text-sm font-medium text-gray-700 shadow-sm border border-gray-300 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                          Change
                          <%= file_field_tag "user[profile_attributes][avatar]", 
                              class: "sr-only",
                              data: { 
                                avatar_upload_target: "input"
                              } %>
                        </span>
                      </label>
                      <% if pf.object.persisted? && pf.object.avatar.attached? %>
                        <div>
                          <%= label_tag :remove_avatar, class: "flex items-center text-sm text-gray-700" do %>
                            <%= check_box_tag :remove_avatar, 
                                "1", 
                                false, 
                                class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded",
                                data: { 
                                  avatar_upload_target: "removeCheckbox",
                                  action: "change->avatar-upload#removeAvatar"
                                } %>
                            <span class="ml-2">Remove</span>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>

              <% else %>
                <!-- Fan Fields -->
                <div class="field">
                  <%= pf.label :favorite_genres, "Favorite Genres", class: "block text-sm font-medium text-gray-700 mb-1" %>
                  <div class="relative mt-1">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                      <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M18 3a1 1 0 00-1.447-.894L8.763 6H5a3 3 0 000 6h.28l1.771 5.316A1 1 0 008 18h1a1 1 0 001-1v-4.382l6.553 3.276A1 1 0 0018 15V3z" />
                      </svg>
                    </div>
                    <%= pf.text_field :favorite_genres, class: "pl-10 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 py-2" %>
                  </div>
                  <p class="mt-1 text-xs text-gray-500">Separate genres with commas</p>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Submit Button -->
    <div class="pt-6">
      <%= f.submit "Update Profile", class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors duration-150" %>
    </div>
  <% end %>

  <!-- Danger Zone -->
  <div class="mt-8 pt-8 border-t border-gray-200">
    <div class="bg-red-50 p-6 rounded-lg">
      <h3 class="text-lg font-medium text-red-800 mb-3 flex items-center">
        <svg class="h-5 w-5 text-red-600 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
        Danger Zone
      </h3>
      <p class="text-sm text-red-700 mb-4">Once you delete your account, there is no going back. Please be certain.</p>
      <%= button_to "Delete my account", registration_path(resource_name), 
            data: { confirm: "Are you sure you want to delete your account? This action cannot be undone.", turbo_confirm: "Are you sure you want to delete your account? This action cannot be undone." }, 
            method: :delete, 
            class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors duration-150" %>
    </div>
  </div>
</div>