<div class="min-h-screen bg-gray-100 py-8">
  <div class="max-w-4xl mx-auto px-4">
    <div class="bg-white rounded-xl shadow-md overflow-hidden p-6 md:p-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-6">Edit Album</h1>
      
      <%= form_with(model: @album, local: true, class: "space-y-6") do |f| %>
        <!-- Cover Art URL with Preview -->
        <div class="space-y-2">
          <%= f.label :cover_url, "Album Cover URL", class: "block text-sm font-medium text-gray-700" %>
          <%= f.url_field :cover_url, 
                class: "mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm",
                placeholder: "https://example.com/album-cover.jpg" %>
          <div class="mt-1">
            <% if @album.cover_url.present? %>
              <img id="cover-preview" src="<%= @album.cover_url %>" alt="Cover preview" class="max-w-xs rounded-lg border border-gray-200">
            <% else %>
              <img id="cover-preview" src="" alt="Cover preview" class="hidden max-w-xs rounded-lg border border-gray-200">
            <% end %>
          </div>
          <p class="text-xs text-gray-500">Must be a valid image URL (JPEG, PNG)</p>
        </div>

        <!-- Title -->
        <div class="space-y-2">
          <%= f.label :title, class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_field :title, 
                class: "mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm",
                maxlength: 100,
                placeholder: "Album title (max 100 characters)" %>
        </div>

        <!-- Description -->
        <div class="space-y-2">
          <%= f.label :description, class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_area :description, rows: 4,
                class: "mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm",
                placeholder: "Tell listeners about your album..." %>
        </div>

        <!-- Genre & Release Date -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2">
            <%= f.label :genre, class: "block text-sm font-medium text-gray-700" %>
            <%= f.select :genre, 
                  options_for_select([
                    ['Rock', 'rock'],
                    ['Electronic', 'electronic'],
                    ['Hip Hop/Rap', 'hip_hop'],
                    ['Jazz', 'jazz'],
                    ['Classical', 'classical'],
                    ['Pop', 'pop'],
                    ['R&B/Soul', 'rnb'],
                    ['Metal', 'metal'],
                    ['Folk', 'folk'],
                    ['Experimental', 'experimental'],
                    ['Other', 'other']
                  ], @album.genre), 
                  { prompt: "Select genre" },
                  class: "mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
          </div>

          <div class="space-y-2">
            <%= f.label :release_date, class: "block text-sm font-medium text-gray-700" %>
            <%= f.date_field :release_date, 
                  class: "mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
          </div>
        </div>

        <!-- Price -->
        <div class="space-y-2">
          <%= f.label :price_cents, "Price (USD)", class: "block text-sm font-medium text-gray-700" %>
          <div class="relative rounded-md shadow-sm">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <span class="text-gray-500 sm:text-sm">$</span>
            </div>
            <%= f.number_field :price_cents, 
                  step: 100,
                  min: 0,
                  value: @album.price_cents.present? ? @album.price_cents / 100.0 : nil,
                  class: "mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm",
                  placeholder: "0.00" %>
            <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
              <span class="text-gray-500 sm:text-sm">USD</span>
            </div>
          </div>
          <p class="text-xs text-gray-500">Set to 0 for free download</p>
        </div>

        <!-- Form Actions -->
        <div class="flex justify-between pt-6">
          <%= link_to "Delete Album", album_path(@album), 
                method: :delete, 
                data: { confirm: "Are you sure you want to delete this album?" },
                class: "px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" %>
          
          <div class="flex space-x-4">
            <%= link_to "Cancel", albums_path, class: "px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50" %>
            <%= f.submit "Update Album", class: "px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  // Preview cover image when URL changes
  document.addEventListener('DOMContentLoaded', function() {
    const coverUrlField = document.querySelector('#album_cover_url');
    const coverPreview = document.querySelector('#cover-preview');
    
    if (coverUrlField && coverPreview) {
      // Initialize with current cover if it exists
      if (coverPreview.src && !coverPreview.classList.contains('hidden')) {
        coverPreview.classList.remove('hidden');
      }
      
      coverUrlField.addEventListener('input', function() {
        if (this.value.match(/\.(jpeg|jpg|gif|png)$/) != null) {
          coverPreview.src = this.value;
          coverPreview.classList.remove('hidden');
        } else {
          coverPreview.classList.add('hidden');
        }
      });
    }
  });
</script>