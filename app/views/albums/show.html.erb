<div class="min-h-screen bg-gray-100 py-8">
  <div class="max-w-4xl mx-auto px-4">
    <div class="bg-white rounded-xl shadow-md overflow-hidden">
      <!-- Album Header -->
      <div class="relative">
        <% if @album.cover_url.present? %>
          <img src="<%= @album.cover_url %>" alt="<%= @album.title %>" class="w-full h-64 object-cover">
        <% else %>
          <div class="w-full h-64 bg-gradient-to-r from-indigo-500 to-purple-600 flex items-center justify-center">
            <i class="fas fa-compact-disc text-white text-6xl"></i>
          </div>
        <% end %>
        <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black to-transparent p-6">
          <div class="flex justify-between items-end">
            <div>
              <h1 class="text-3xl font-bold text-white"><%= @album.title %></h1>
              <p class="text-indigo-200"><%= @album.genre.capitalize %> • Released <%= @album.release_date.strftime("%B %Y") %></p>
            </div>
            <div class="text-right">
              <p class="text-2xl font-bold text-white"><%= number_to_currency(@album.price_cents.to_f / 100) %></p>
              <% if @album.price_cents.positive? %>
                <button class="mt-2 px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">
                  Buy Now
                </button>
              <% else %>
                <button class="mt-2 px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700">
                  Free Download
                </button>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Album Content -->
      <div class="p-6 md:p-8">
        <div class="flex justify-between items-start mb-6">
          <div class="max-w-2xl">
            <h2 class="text-xl font-semibold mb-2">About This Album</h2>
            <p class="text-gray-700"><%= @album.description %></p>
          </div>
          
          <div class="flex space-x-3">
            <%= link_to edit_album_path(@album), class: "p-2 text-gray-500 hover:text-indigo-600 hover:bg-gray-100 rounded-full" do %>
              <i class="fas fa-edit"></i>
            <% end %>
            <%= link_to album_path(@album), 
                  method: :delete,
                  data: { confirm: "Are you sure you want to delete this album?" },
                  class: "p-2 text-gray-500 hover:text-red-600 hover:bg-gray-100 rounded-full" do %>
              <i class="fas fa-trash"></i>
            <% end %>
          </div>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
          <div class="bg-gray-50 p-4 rounded-lg text-center">
            <p class="text-sm text-gray-500">Listens</p>
            <p class="text-2xl font-bold">1,248</p>
          </div>
          <div class="bg-gray-50 p-4 rounded-lg text-center">
            <p class="text-sm text-gray-500">Downloads</p>
            <p class="text-2xl font-bold">892</p>
          </div>
          <div class="bg-gray-50 p-4 rounded-lg text-center">
            <p class="text-sm text-gray-500">Revenue</p>
            <p class="text-2xl font-bold"><%= number_to_currency(1250) %></p>
          </div>
          <div class="bg-gray-50 p-4 rounded-lg text-center">
            <p class="text-sm text-gray-500">Rating</p>
            <div class="flex justify-center items-center">
              <i class="fas fa-star text-yellow-400"></i>
              <span class="ml-1 font-bold">4.8</span>
            </div>
          </div>
        </div>

        <!-- Placeholder for Tracks (when you add them later) -->
        <div class="border-t pt-6">
          <h2 class="text-xl font-semibold mb-4">Tracks</h2>
          <div class="bg-gray-50 rounded-lg p-8 text-center">
            <i class="fas fa-music text-gray-300 text-4xl mb-3"></i>
            <p class="text-gray-500">No tracks added yet</p>
            <%= link_to "Add your first track", "#", class: "mt-2 text-indigo-600 hover:underline inline-block" %>
          </div>
        </div>
      </div>
    </div>

    <!-- Back button -->
   
  </div>
</div>