<%# Title %>
<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <h1 class="text-3xl font-bold text-gray-900 mb-8">Edit Profile</h1>

  <%= form_with(model: @artist_profile, local: true, class: "space-y-8") do |f| %>
    <% if @artist_profile.errors.any? %>
      <div class="bg-red-50 border border-red-400 text-red-700 px-4 py-3 rounded relative" role="alert">
        <strong class="font-bold">Please fix the following errors:</strong>
        <ul class="mt-2 list-disc list-inside">
          <% @artist_profile.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%# Cover Image %>
    <div>
      <label class="block text-sm font-medium text-gray-700">Cover Image</label>
      <div class="mt-2 flex items-center">
        <% if @artist_profile.cover_image.attached? %>
          <div class="relative w-full h-48">
            <%= image_tag @artist_profile.cover_image, class: "w-full h-full object-cover rounded-lg" %>
          </div>
        <% end %>
      </div>
      <div class="mt-2">
        <%= f.file_field :cover_image, class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100" %>
      </div>
    </div>

    <%# Avatar %>
    <div>
      <label class="block text-sm font-medium text-gray-700">Profile Picture</label>
      <div class="mt-2 flex items-center">
        <% if @artist_profile.avatar.attached? %>
          <%= image_tag @artist_profile.avatar, class: "h-24 w-24 rounded-full object-cover" %>
        <% end %>
      </div>
      <div class="mt-2">
        <%= f.file_field :avatar, class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100" %>
      </div>
    </div>

    <%# Name %>
    <div>
      <%= f.label :name, class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <%# Bio %>
    <div>
      <%= f.label :bio, class: "block text-sm font-medium text-gray-700" %>
      <div class="mt-1">
        <%= f.text_area :bio, rows: 5, class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
      </div>
      <p class="mt-2 text-sm text-gray-500">Write a brief description about yourself.</p>
    </div>

    <%# Location %>
    <div>
      <%= f.label :location, class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :location, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <%# Website URL %>
    <div>
      <%= f.label :website_url, "Website URL", class: "block text-sm font-medium text-gray-700" %>
      <%= f.url_field :website_url, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <%# Submit Button %>
    <div class="pt-5">
      <div class="flex justify-end">
        <%= link_to "Cancel", artist_profile_path(@artist_profile), class: "bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
        <%= f.submit "Save Changes", class: "ml-3 inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
      </div>
    </div>
  <% end %>
</div>
