<!-- Artist Header Section -->
<div class="bg-gradient-to-b from-music-background to-music-surface text-music-text">
  <% if @artist_profile.cover_image.attached? %>
    <div class="w-full h-64 md:h-80 lg:h-96 overflow-hidden relative">
      <%= image_tag @artist_profile.cover_image, class: "w-full h-full object-cover" %>
      <div class="absolute inset-0 bg-gradient-to-t from-music-background via-transparent to-transparent"></div>
    </div>
  <% end %>

  <div class="container mx-auto px-4 py-8 md:py-12">
    <div class="flex flex-col md:flex-row items-start md:items-center gap-8">
      <!-- Avatar with Glow Effect -->
      <div class="relative">
        <div class="w-32 h-32 md:w-48 md:h-48 rounded-full overflow-hidden border-4 border-music-accent shadow-lg relative z-10">
          <% if @artist_profile.avatar.attached? %>
            <%= image_tag @artist_profile.avatar, class: "w-full h-full object-cover" %>
          <% else %>
            <div class="w-full h-full bg-music-surface flex items-center justify-center">
              <svg class="w-16 h-16 text-music-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
          <% end %>
        </div>
        <div class="absolute -inset-2 bg-music-accent/30 rounded-full blur-md opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
      </div>

      <!-- Profile Details -->
      <div class="flex-1">
        <h1 class="text-3xl md:text-5xl font-bold mb-2 font-display tracking-tight"><%= @artist_profile.name %></h1>
        
        <% if @artist_profile.location.present? %>
          <div class="flex items-center text-music-text-secondary mb-4">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span><%= @artist_profile.location %></span>
          </div>
        <% end %>

        <!-- Stats and Tags -->
        <div class="flex flex-wrap items-center gap-3 mb-6">
          <span class="bg-music-surface/80 border border-music-border/50 px-3 py-1 rounded-full text-sm backdrop-blur-sm">
            <%= pluralize(@artist_profile.user.followers.count, 'follower') %>
          </span>
       
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap gap-3">
          <button class="px-6 py-3 bg-music-primary hover:bg-music-primary/90 text-music-background rounded-button font-display tracking-wider flex items-center shadow-button hover:shadow-genre-hover transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
            </svg>
            PLAY ALL
          </button>
          
          <% if user_signed_in? && @artist_profile.user == current_user %>
            <%= link_to edit_artist_profile_path(@artist_profile), 
                  class: "px-6 py-3 bg-music-surface hover:bg-music-border border border-music-border text-music-text rounded-button font-display tracking-wider flex items-center transition-all" do %>
              <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
              EDIT PROFILE
            <% end %>
          <% elsif user_signed_in? && current_user.fan? %>
            <% if current_user.following?(@artist_profile.user) %>
              <%= button_to unfollow_artist_profile_path(@artist_profile), method: :delete, 
                        class: "px-6 py-3 bg-music-surface hover:bg-music-border border border-music-border text-music-text rounded-button font-display tracking-wider flex items-center transition-all",
                        data: { confirm: "Unfollow #{@artist_profile.name}?" } do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                FOLLOWING
              <% end %>
            <% else %>
              <%= button_to follow_artist_profile_path(@artist_profile), method: :post,
                        class: "px-6 py-3 bg-music-secondary hover:bg-music-secondary/90 text-music-background rounded-button font-display tracking-wider flex items-center transition-all" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" />
                </svg>
                FOLLOW
              <% end %>
            <% end %>
          <% elsif !user_signed_in? %>
            <%= link_to new_user_registration_path, 
                  class: "px-6 py-3 bg-music-secondary hover:bg-music-secondary/90 text-music-background rounded-button font-display tracking-wider flex items-center transition-all" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" />
              </svg>
              FOLLOW
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Main Content -->
<main class="bg-music-background text-music-text min-h-screen">
  <div class="container mx-auto px-4 py-8" data-controller="tabs">
    <!-- Artist Navigation Tabs -->
    <nav class="flex border-b border-music-border/50 mb-8">
      <button data-tabs-target="tab" data-tab="music" data-action="click->tabs#switchTab" 
              class="px-6 py-3 font-display tracking-wider text-music-primary border-b-2 border-music-primary">
        MUSIC
      </button>
      <button data-tabs-target="tab" data-tab="about" data-action="click->tabs#switchTab" 
              class="px-6 py-3 font-display tracking-wider text-music-text-secondary hover:text-music-primary transition-colors">
        ABOUT
      </button>
      <button data-tabs-target="tab" data-tab="shows" data-action="click->tabs#switchTab" 
              class="px-6 py-3 font-display tracking-wider text-music-text-secondary hover:text-music-primary transition-colors">
        SHOWS
      </button>
      <button data-tabs-target="tab" data-tab="merch" data-action="click->tabs#switchTab" 
              class="px-6 py-3 font-display tracking-wider text-music-text-secondary hover:text-music-primary transition-colors">
        MERCH
      </button>
    </nav>

    <!-- Music Tab -->
    <section data-tabs-target="content" data-content="music" class="mb-12">
      <h2 class="text-2xl font-display tracking-tight mb-6">DISCOGRAPHY</h2>
      <%= render 'shared/album_list', 
          releases: @releases,
          layout: 'grid',
          show_play_button: true,
          show_price: true,
          show_release_type: true,
          show_artist: false,
          show_date: true,
          grid_cols: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4',
          empty_message: 'No releases yet',
          empty_icon: 'fas fa-compact-disc' %>
    </section>

    <!-- About Tab -->
    <section data-tabs-target="content" data-content="about" class="mb-12 hidden">
      <h2 class="text-2xl font-display tracking-tight mb-6">ABOUT</h2>
      <div class="bg-music-surface/80 backdrop-blur-sm rounded-genre shadow-genre p-6">
        <% if @artist_profile.bio.present? %>
          <div class="prose prose-invert max-w-none text-music-text">
            <%= simple_format @artist_profile.bio %>
          </div>
        <% else %>
          <p class="text-music-text-secondary italic">No bio available</p>
        <% end %>

        <% if @artist_profile.website_url.present? %>
          <div class="mt-6">
            <%= link_to @artist_profile.website_url, 
                  class: "inline-flex items-center text-music-secondary hover:text-music-primary transition-colors", 
                  target: "_blank", rel: "noopener noreferrer" do %>
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
              </svg>
              Official Website
            <% end %>
          </div>
        <% end %>
      </div>
    </section>

    <!-- Shows Tab -->
    <section data-tabs-target="content" data-content="shows" class="mb-12 hidden">
      <h2 class="text-2xl font-display tracking-tight mb-6">UPCOMING SHOWS</h2>
      <div class="bg-music-surface/80 backdrop-blur-sm rounded-genre shadow-genre p-8 text-center">
        <svg class="mx-auto h-12 w-12 text-music-text-secondary mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <p class="text-music-text-secondary">No upcoming shows scheduled.</p>
      </div>
    </section>

    <!-- Merch Tab -->
    <section data-tabs-target="content" data-content="merch" class="mb-12 hidden">
      <h2 class="text-2xl font-display tracking-tight mb-6">MERCHANDISE</h2>
      <div class="bg-music-surface/80 backdrop-blur-sm rounded-genre shadow-genre p-8 text-center">
        <svg class="mx-auto h-12 w-12 text-music-text-secondary mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
        <p class="text-music-text-secondary">No merchandise available at this time.</p>
      </div>
    </section>
  </div>
</main>