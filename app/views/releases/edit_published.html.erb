<%= turbo_frame_tag dom_id(@release) do %>
  <div class="min-h-screen bg-music-background">
    <div class="max-w-6xl mx-auto px-4 py-8">
      <!-- Header -->
      <div class="mb-8">
        <div class="flex items-center justify-between mb-4">
          <h1 class="text-3xl font-display tracking-tight text-music-text">
            Edit Published Release
          </h1>
          <%= link_to "← Back to Release", @release, class: "text-music-primary hover:text-music-accent transition-colors" %>
        </div>
        
        <!-- Published Release Notice -->
        <div class="bg-blue-500/10 border border-blue-500/30 rounded-genre p-4 mb-6">
          <div class="flex items-start">
            <i class="fas fa-info-circle text-blue-500 mt-1 mr-3"></i>
            <div>
              <h3 class="font-semibold text-blue-500 mb-2">Published Release Editing</h3>
              <p class="text-blue-400 text-sm mb-3">
                This release is published and has limited editing capabilities to maintain distribution integrity.
              </p>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                <div>
                  <h4 class="font-medium text-blue-400 mb-1">✅ You CAN edit:</h4>
                  <ul class="text-blue-300 space-y-1">
                    <li>• Release title and description</li>
                    <li>• Release date and genre</li>
                    <li>• Cover art</li>
                    <li>• Track titles and featured artists</li>
                    <li>• Replace track audio files (same count)</li>
                  </ul>
                </div>
                <div>
                  <h4 class="font-medium text-red-400 mb-1">❌ You CANNOT edit:</h4>
                  <ul class="text-red-300 space-y-1">
                    <li>• Release type (Single, EP, Album)</li>
                    <li>• Artist name</li>
                    <li>• Price</li>
                    <li>• Add or remove tracks</li>
                    <li>• Track order or duration</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Edit Form -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Left Column: Release Info -->
        <div class="lg:col-span-2">
          <div class="bg-music-surface rounded-genre shadow-genre border border-music-border p-6">
            <h2 class="text-xl font-semibold mb-6 font-display text-music-text">Release Information</h2>
            
            <%= form_with(model: @release, local: true, class: "space-y-6") do |form| %>
              <% if flash[:alert] %>
                <div class="mb-6 p-4 bg-red-500/10 border border-red-500/30 rounded-genre">
                  <h3 class="font-semibold mb-2 text-red-500 flex items-center">
                    <i class="fas fa-exclamation-circle mr-2"></i>
                    Please correct the following errors:
                  </h3>
                  <ul class="list-disc list-inside text-sm text-red-400">
                    <% flash[:alert].split(", ").each do |msg| %>
                      <li><%= msg %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>

              <!-- Release Type (Read-only) -->
              <div class="mb-6">
                <label class="block text-music-text text-sm font-medium mb-2">Release Type</label>
                <div class="flex items-center">
                  <span class="inline-flex items-center px-3 py-2 rounded-genre text-sm font-medium bg-music-surface text-music-text border border-music-border">
                    <%= @release.release_type_human %>
                  </span>
                  <span class="ml-3 text-sm text-music-text-secondary">
                    <i class="fas fa-lock mr-1"></i>Cannot be changed
                  </span>
                </div>
              </div>

              <!-- Artist (Read-only) -->
              <div class="mb-6">
                <label class="block text-music-text text-sm font-medium mb-2">Artist</label>
                <div class="flex items-center">
                  <span class="inline-flex items-center px-3 py-2 rounded-genre text-sm font-medium bg-music-surface text-music-text border border-music-border">
                    <%= @release.artist %>
                  </span>
                  <span class="ml-3 text-sm text-music-text-secondary">
                    <i class="fas fa-lock mr-1"></i>Cannot be changed
                  </span>
                </div>
              </div>

              <!-- Title (Editable) -->
              <div class="mb-6">
                <%= form.label :title, class: "block text-music-text text-sm font-medium mb-2" %>
                <%= form.text_field :title, class: "w-full px-3 py-2 border border-music-border bg-music-background text-music-text rounded-genre focus:outline-none focus:ring-2 focus:ring-music-primary focus:border-music-primary placeholder-music-text-secondary" %>
              </div>

              <!-- Release Date (Editable) -->
              <div class="mb-6">
                <%= form.label :release_date, class: "block text-music-text text-sm font-medium mb-2" %>
                <%= form.date_field :release_date, class: "w-full px-3 py-2 border border-music-border bg-music-background text-music-text rounded-genre focus:outline-none focus:ring-2 focus:ring-music-primary focus:border-music-primary" %>
              </div>

              <!-- Genre (Editable) -->
              <div class="mb-6">
                <%= form.label :genre, class: "block text-music-text text-sm font-medium mb-2" %>
                <%= form.select :genre, options_for_select([['Select a genre', '']] + Release::GENRES.map { |genre| [genre, genre] }, @release.genre), 
                               {}, 
                               { class: "w-full px-3 py-2 border border-music-border bg-music-background text-music-text rounded-genre focus:outline-none focus:ring-2 focus:ring-music-primary focus:border-music-primary" } %>
              </div>

              <!-- Description (Editable) -->
              <div class="mb-6">
                <%= form.label :description, class: "block text-music-text text-sm font-medium mb-2" %>
                <%= form.text_area :description, rows: 4, class: "w-full px-3 py-2 border border-music-border bg-music-background text-music-text rounded-genre focus:outline-none focus:ring-2 focus:ring-music-primary focus:border-music-primary placeholder-music-text-secondary" %>
              </div>

              <!-- Cover Art Upload -->
              <div class="mb-6">
                <%= form.label :cover_art, "Cover Art", class: "block text-music-text text-sm font-medium mb-2" %>
                <div class="border-2 border-dashed border-music-border bg-music-background rounded-genre p-6 text-center cursor-pointer hover:border-music-primary transition-colors duration-200"
                     data-controller="image-upload-base"
                     data-action="dragover->image-upload-base#highlight dragleave->image-upload-base#unhighlight drop->image-upload-base#drop">
                  <div data-image-upload-base-target="container" 
                       class="cursor-pointer <%= 'hidden' if @release.cover_art.attached? %>">
                    <i class="fas fa-image text-music-text-secondary text-4xl mb-2"></i>
                    <p class="text-music-text-secondary text-sm">Drag & drop new cover art here</p>
                    <p class="text-music-text-secondary text-xs mt-1 opacity-70">or click to browse (JPEG/PNG, max 10MB)</p>
                  </div>
                  <div data-image-upload-base-target="preview" class="<%= 'hidden' unless @release.cover_art.attached? %>">
                    <% if @release.cover_art.attached? %>
                      <div class="flex flex-col items-center">
                        <div class="relative">
                          <%= image_tag @release.cover_art.variant(:medium), class: "max-w-full max-h-48 rounded-genre mb-2" %>
                          <button type="button" 
                                  class="absolute top-0 right-0 bg-music-primary text-music-text rounded-full w-6 h-6 flex items-center justify-center hover:bg-opacity-80 transition-all duration-200"
                                  data-action="click->image-upload-base#clearFile">
                            ×
                          </button>
                        </div>
                        <p class="text-sm text-music-text-secondary mt-2"><%= @release.cover_art.filename %></p>
                      </div>
                    <% end %>
                  </div>
                  <%= form.file_field :cover_art, 
                                    direct_upload: true,
                                    accept: "image/*",
                                    class: "hidden",
                                    data: { image_upload_base_target: "input", action: "change->image-upload-base#inputChange" } %>
                </div>
              </div>

              <!-- Submit Button -->
              <div class="flex justify-end space-x-4 pt-6 border-t border-music-border/30">
                <%= link_to "Cancel", @release, class: "px-6 py-2 border border-music-border bg-music-surface text-music-text rounded-button hover:bg-opacity-80 transition-all duration-200" %>
                <%= form.submit "Update Release", class: "px-6 py-2 bg-music-primary text-music-background rounded-button hover:bg-opacity-80 focus:outline-none focus:ring-2 focus:ring-music-primary shadow-button transition-all duration-200" %>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Right Column: Tracks -->
        <div class="lg:col-span-1">
          <div class="bg-music-surface rounded-genre shadow-genre border border-music-border p-6">
            <h2 class="text-xl font-semibold mb-6 font-display text-music-text">Tracks</h2>
            
            <div class="space-y-4">
              <% @release.tracks.order(:position).each do |track| %>
                <div class="border border-music-border/50 rounded-genre p-4 bg-music-background/20">
                  <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center gap-2">
                      <span class="text-sm font-medium text-music-text bg-music-surface px-2 py-1 rounded-full border border-music-border/30">
                        #<%= track.position %>
                      </span>
                      <h4 class="font-medium text-music-text"><%= track.display_title %></h4>
                    </div>
                    <%= link_to edit_release_track_path(@release, track), class: "text-music-primary hover:text-music-accent transition-colors" do %>
                      <i class="fas fa-edit"></i>
                    <% end %>
                  </div>
                  
                  <% if track.duration.present? %>
                    <p class="text-sm text-music-text-secondary mb-2">
                      Duration: <%= Time.at(track.duration).utc.strftime("%M:%S") %>
                    </p>
                  <% end %>
                  
                  <div class="text-xs text-music-text-secondary">
                    <i class="fas fa-lock mr-1"></i>Position and duration cannot be changed
                  </div>
                </div>
              <% end %>
            </div>

            <div class="mt-6 p-4 bg-yellow-500/10 border border-yellow-500/30 rounded-genre">
              <h4 class="font-medium text-yellow-500 mb-2 flex items-center">
                <i class="fas fa-exclamation-triangle mr-2"></i>
                Track Management
              </h4>
              <p class="text-yellow-400 text-sm">
                You can edit track titles and featured artists, and replace audio files. 
                Adding or removing tracks is not allowed for published releases.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %> 