

<div class="container mx-auto px-4 py-6">
  <div class="flex items-center gap-4 mb-6">
    <%= link_to artist_profile_path(@release.user.artist_profile), class: "text-gray-500 hover:text-teal-600" do %>
      <i class="fas fa-arrow-left"></i>
    <% end %>
    <h1 class="text-2xl font-bold text-gray-800">Release Details</h1>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden">
    <div class="md:flex">
      <div class="md:w-1/3">
        <% if @release.cover_art.attached? %>
          <%= image_tag @release.cover_art.variant(:medium), class: "w-full h-full object-cover" %>
        <% else %>
          <div class="w-full h-64 md:h-full bg-gray-100 flex items-center justify-center text-gray-400">
            <i class="fas fa-compact-disc text-6xl"></i>
          </div>
        <% end %>
      </div>

      <div class="p-6 md:w-2/3">
        <div class="flex justify-between items-start">
          <div>
            <h2 class="text-2xl font-bold text-gray-800"><%= @release.title %></h2>
            <h3 class="text-xl text-gray-600 mb-4"><%= @release.artist %></h3>
          </div>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-teal-100 text-teal-800">
            <%= @release.release_type_human %>
          </span>
        </div>

        <div class="grid grid-cols-2 gap-4 mt-6">
          <div>
            <p class="text-sm text-gray-500">Release Date</p>
            <p class="font-medium"><%= @release.release_date %></p>
          </div>
          <div>
            <p class="text-sm text-gray-500">Price</p>
            <p class="font-medium"><%= number_to_currency(@release.price) %></p>
          </div>
          <div>
            <p class="text-sm text-gray-500">Added By</p>
            <p class="font-medium"><%= @release.user.email %></p>
          </div>
          <div>
            <p class="text-sm text-gray-500">Created</p>
            <p class="font-medium"><%= @release.created_at.to_formatted_s(:short) %></p>
          </div>
        </div>

        <div class="mt-8 flex gap-3">
          <% if user_signed_in? && current_user == @release.user %>
            <%# Show Edit/Delete buttons only to the release owner %>
            <%= link_to edit_release_path(@release), class: "flex-1 flex items-center justify-center gap-2 bg-teal-600 hover:bg-teal-700 text-white px-4 py-2 rounded-lg transition-colors" do %>
              <i class="fas fa-edit"></i>
              <span>Edit Release</span>
            <% end %>
            <div class="flex-1">
              <%= form_with url: release_path(@release), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this release? This action cannot be undone." }, class: "w-full" do %>
                <button type="submit" class="w-full flex items-center justify-center gap-2 bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg transition-colors border-0">
                  <i class="fas fa-trash"></i>
                  <span>Delete Release</span>
                </button>
              <% end %>
            </div>
          <% elsif user_signed_in? && current_user.fan? %>
            <%# Show Buy button only to fan users (non-owners) %>
            <button class="flex-1 flex items-center justify-center gap-2 bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg transition-colors">
              <i class="fas fa-shopping-cart"></i>
              <span>Buy <%= number_to_currency(@release.price) %></span>
            </button>
          <% elsif !user_signed_in? %>
            <%# Show sign in prompt for non-authenticated users %>
            <%= link_to new_user_session_path, class: "flex-1 flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition-colors" do %>
              <i class="fas fa-sign-in-alt"></i>
              <span>Sign in to Purchase</span>
            <% end %>
          <% end %>
          
          <%# Back button always visible %>
          <%= link_to artist_profile_path(@release.user.artist_profile), class: "flex-1 flex items-center justify-center gap-2 bg-white hover:bg-gray-50 text-gray-700 border border-gray-300 px-4 py-2 rounded-lg transition-colors" do %>
            <i class="fas fa-user"></i>
            <span>View Artist</span>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Tracks Section -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-100 mt-6 overflow-hidden">
    <div class="p-6 border-b border-gray-100">
      <div class="flex justify-between items-center">
        <h3 class="text-lg font-semibold text-gray-800">Tracks</h3>
        <% if user_signed_in? && current_user == @release.user %>
          <%# Show Add Track button only to the release owner %>
          <%= link_to new_release_track_path(@release), class: "inline-flex items-center gap-2 bg-teal-600 hover:bg-teal-700 text-white px-4 py-2 rounded-lg transition-colors text-sm" do %>
            <i class="fas fa-plus"></i>
            <span>Add Track</span>
          <% end %>
        <% end %>
      </div>
    </div>

    <% if @release.tracks.any? %>
      <div class="divide-y divide-gray-100">
        <% @release.tracks.order(:position).each do |track| %>
          <div class="p-4 hover:bg-gray-50 transition-colors">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-4">
                <span class="text-sm font-medium text-gray-500 bg-gray-100 px-2 py-1 rounded">
                  #<%= track.position %>
                </span>
                <div>
                  <h4 class="font-medium text-gray-900"><%= track.title %></h4>
                  <% if track.duration.present? %>
                    <p class="text-sm text-gray-500">
                      Duration: <%= Time.at(track.duration).utc.strftime("%M:%S") %>
                    </p>
                  <% end %>
                </div>
              </div>
              <div class="flex items-center gap-2">
                <% if user_signed_in? && current_user == @release.user %>
                  <%# Show Edit/Delete buttons only to the release owner %>
                  <%= link_to edit_release_track_path(@release, track), class: "inline-flex items-center gap-1 px-3 py-1 text-sm bg-teal-100 hover:bg-teal-200 text-teal-700 rounded transition-colors" do %>
                    <i class="fas fa-edit text-xs"></i>
                    <span>Edit</span>
                  <% end %>
                  <div>
                    <%= form_with url: release_track_path(@release, track), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this track?" } do %>
                      <button type="submit" class="inline-flex items-center gap-1 px-3 py-1 text-sm bg-red-100 hover:bg-red-200 text-red-700 rounded transition-colors border-0">
                        <i class="fas fa-trash text-xs"></i>
                        <span>Remove</span>
                      </button>
                    <% end %>
                  </div>
                <% else %>
                  <%# Show play button or similar for non-owners %>
                  <button class="inline-flex items-center gap-1 px-3 py-1 text-sm bg-blue-100 hover:bg-blue-200 text-blue-700 rounded transition-colors">
                    <i class="fas fa-play text-xs"></i>
                    <span>Play</span>
                  </button>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="p-8 text-center text-gray-500">
        <i class="fas fa-music text-3xl mb-3"></i>
        <p class="text-lg mb-2">No tracks yet</p>
        <p class="text-sm">Add your first track to this release</p>
      </div>
    <% end %>
  </div>
</div>
