<div class="container mx-auto px-4 py-6">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-800">My Releases</h1>
    <%= link_to step1_release_wizard_index_path, class: "flex items-center gap-2 bg-teal-600 hover:bg-teal-700 text-white px-4 py-2 rounded-lg transition-colors" do %>
      <i class="fas fa-plus"></i>
      <span>New Release</span>
    <% end %>
  </div>

  <%= render 'shared/album_list', 
      releases: @releases,
      layout: 'list',
      show_play_button: false,
      show_price: true,
      show_release_type: true,
      show_artist: true,
      show_date: true,
      empty_message: 'You haven\'t published anything yet',
      empty_icon: 'fas fa-compact-disc' %>
</div>
