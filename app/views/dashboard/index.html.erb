<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Artist Dashboard - Bandcamp Style</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
  <div class="min-h-screen flex flex-col">
    <!-- Header -->
    <%= render 'shared/header' %>
    <!-- Main Content -->
    <main class="flex-grow container mx-auto px-4 py-6">
      <div class="flex flex-col md:flex-row gap-6">
        <!-- Sidebar -->
        <aside class="w-full md:w-64 flex-shrink-0">
          <div class="bg-white rounded-lg shadow p-4 mb-6">
            <h3 class="font-bold text-lg mb-4">Quick Actions</h3>
            <ul class="space-y-2">
              <li>
                <a href="#" class="flex items-center space-x-2 text-indigo-700 hover:text-indigo-900">
                  <i class="fas fa-plus-circle"></i>
                  <span>New Release</span>
                </a>
              </li>
              <li>
                <a href="#" class="flex items-center space-x-2 text-gray-700 hover:text-indigo-900">
                  <i class="fas fa-tshirt"></i>
                  <span>Add Merch</span>
                </a>
              </li>
              <li>
                <a href="#" class="flex items-center space-x-2 text-gray-700 hover:text-indigo-900">
                  <i class="fas fa-chart-line"></i>
                  <span>View Stats</span>
                </a>
              </li>
              <li>
                <a href="#" class="flex items-center space-x-2 text-gray-700 hover:text-indigo-900">
                  <i class="fas fa-cog"></i>
                  <span>Settings</span>
                </a>
              </li>
            </ul>
          </div>

          <div class="bg-white rounded-lg shadow p-4">
            <h3 class="font-bold text-lg mb-4">Recent Activity</h3>
            <ul class="space-y-3">
              <li class="flex items-start space-x-2">
                <div class="text-green-500">
                  <i class="fas fa-shopping-cart"></i>
                </div>
                <div>
                  <p class="text-sm">New album purchase</p>
                  <p class="text-xs text-gray-500">"Summer Waves" by Sarah Fan</p>
                </div>
              </li>
              <li class="flex items-start space-x-2">
                <div class="text-blue-500">
                  <i class="fas fa-download"></i>
                </div>
                <div>
                  <p class="text-sm">Track download</p>
                  <p class="text-xs text-gray-500">"Midnight Drive" (320kbps)</p>
                </div>
              </li>
              <li class="flex items-start space-x-2">
                <div class="text-yellow-500">
                  <i class="fas fa-star"></i>
                </div>
                <div>
                  <p class="text-sm">New fan</p>
                  <p class="text-xs text-gray-500">Alex MusicLover followed you</p>
                </div>
              </li>
            </ul>
          </div>
        </aside>

        <!-- Main Dashboard -->
        <div class="flex-grow">
          <!-- Stats Summary -->
          <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
            <div class="bg-white rounded-lg shadow p-4">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-gray-500 text-sm">Total Earnings</p>
                  <p class="text-2xl font-bold">$1,245.80</p>
                </div>
                <div class="text-green-500 bg-green-100 p-3 rounded-full">
                  <i class="fas fa-wallet text-lg"></i>
                </div>
              </div>
              <p class="text-xs text-green-500 mt-2">+12.5% from last month</p>
            </div>
            <div class="bg-white rounded-lg shadow p-4">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-gray-500 text-sm">Album Sales</p>
                  <p class="text-2xl font-bold">328</p>
                </div>
                <div class="text-blue-500 bg-blue-100 p-3 rounded-full">
                  <i class="fas fa-compact-disc text-lg"></i>
                </div>
              </div>
              <p class="text-xs text-green-500 mt-2">+8.2% from last month</p>
            </div>
            <div class="bg-white rounded-lg shadow p-4">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-gray-500 text-sm">Track Downloads</p>
                  <p class="text-2xl font-bold">1,042</p>
                </div>
                <div class="text-purple-500 bg-purple-100 p-3 rounded-full">
                  <i class="fas fa-music text-lg"></i>
                </div>
              </div>
              <p class="text-xs text-green-500 mt-2">+5.7% from last month</p>
            </div>
            <div class="bg-white rounded-lg shadow p-4">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-gray-500 text-sm">New Fans</p>
                  <p class="text-2xl font-bold">156</p>
                </div>
                <div class="text-yellow-500 bg-yellow-100 p-3 rounded-full">
                  <i class="fas fa-users text-lg"></i>
                </div>
              </div>
              <p class="text-xs text-green-500 mt-2">+22.3% from last month</p>
            </div>
          </div>

          <!-- Albums Section -->
          <div class="bg-white rounded-lg shadow p-6 mb-6">
            <div class="flex justify-between items-center mb-6">
              <h2 class="text-2xl font-bold">Your Albums</h2>
              <button class="bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700 flex items-center space-x-2">
                <i class="fas fa-plus"></i>
                <%= link_to "Create Album", new_album_path %>
              </button>
            </div>
            <% if @albums.any? %>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <% @albums.each do |album| %>
                  <div class="border rounded-lg overflow-hidden hover:shadow-lg transition">
                    <div class="relative">
                      <% if album.cover_url.present? %>
                        <img src="<%= album.cover_url %>" alt="Album Cover" class="w-full h-48 object-cover">
                      <% else %>
                        <div class="w-full h-48 bg-gray-200 flex items-center justify-center">
                          <i class="fas fa-music text-gray-400 text-4xl"></i>
                        </div>
                      <% end %>
                      <div class="absolute bottom-2 right-2 bg-black bg-opacity-70 text-white px-2 py-1 rounded text-sm">
                        <%= number_to_currency(album.price_cents.to_f / 100) %>
                      </div>
                    </div>
                    <div class="p-4">
                      <h3 class="font-bold text-lg mb-1"><%= album.title %></h3>
                      <p class="text-gray-600 text-sm mb-2"><%= album.description %></p>
                      <div class="flex flex-wrap gap-1 mb-3">
                        <span class="bg-purple-100 text-purple-800 text-xs px-2 py-1 rounded">
                          <%= album.genre %>
                        </span>
                        <span class="bg-blue-100 text-blue-800 text-xs px-2 py-1 rounded">
                          Released: <%= album.release_date.strftime("%b %Y") %>
                        </span>
                      </div>
                      <div class="flex justify-end space-x-2">
                        <%= link_to edit_album_path(album), class: "text-gray-500 hover:text-indigo-600" do %>
                          <i class="fas fa-edit"></i>
                        <% end %>
                        <%= link_to album_path(album), class: "text-gray-500 hover:text-indigo-600" do %>
                          <i class="fas fa-eye"></i>
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            <% else %>
              <div class="text-center py-12">
                <i class="fas fa-compact-disc text-4xl text-gray-300 mb-4"></i>
                <p class="text-gray-500">You don't have any albums yet.</p>
                <%= link_to "Create your first album", new_album_path, class: "text-indigo-600 hover:underline mt-2 inline-block" %>
              </div>
            <% end %>
            </div>
          <!-- Recent Sales -->
          <div class="bg-white rounded-lg shadow p-6">
            <h2 class="text-2xl font-bold mb-6">Recent Sales</h2>
            <div class="overflow-x-auto">
              <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                  <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Item</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Buyer</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                  </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                  <tr>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">Today, 14:32</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">Midnight Echoes (Album)</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">michael.fan@email.com</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">$8.00</td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                        Completed
                      </span>
                    </td>
                  </tr>
                  <tr>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">Yesterday, 20:15</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">Summer Waves (Album)</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">sarah.music@email.com</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">$10.00</td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                        Completed
                      </span>
                    </td>
                  </tr>
                  <tr>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">Yesterday, 11:47</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">Midnight Drive (Track)</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">dj.alex@email.com</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">$1.50</td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">
                        Processing
                      </span>
                    </td>
                  </tr>
                  <tr>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">2 days ago, 09:22</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">Urban Dreams (Album)</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">music.lover@email.com</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">$5.00</td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                        Completed
                      </span>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</body>
</html>