<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Artist Dashboard - Bandcamp Style</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
  <div class="min-h-screen flex flex-col">
    <!-- Header -->
    <header class="bg-indigo-900 text-white shadow-md">
      <div class="container mx-auto px-4 py-3 flex justify-between items-center">
        <div class="flex items-center space-x-4">
          <a href="#" class="text-2xl font-bold">ArtSound</a>
          <nav class="hidden md:flex space-x-6">
            <a href="#" class="hover:text-indigo-200">Dashboard</a>
            <a href="#" class="hover:text-indigo-200">Music</a>
            <a href="#" class="hover:text-indigo-200">Merch</a>
            <a href="#" class="hover:text-indigo-200">Stats</a>
            <a href="#" class="hover:text-indigo-200">Fans</a>
          </nav>
        </div>
        <div class="flex items-center space-x-4">
          <% if user_signed_in? %>
            <button class="p-2 rounded-full hover:bg-indigo-800">
              <i class="fas fa-bell"></i>
            </button>
            <div class="relative group">
              <button class="flex items-center space-x-2 focus:outline-none">
                <% if current_user.avatar_url.present? %>
                  <img src="<%= current_user.avatar_url %>" alt="User" class="w-8 h-8 rounded-full">
                <% else %>
                  <div class="w-8 h-8 rounded-full bg-indigo-600 flex items-center justify-center text-white">
                    <%= current_user.name_or_email[0].upcase %>
                  </div>
                <% end %>
                <span><%= current_user.name_or_email %></span>
                <i class="fas fa-chevron-down text-xs"></i>
              </button>
              <div class="absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 z-50 hidden group-hover:block">
                <%= link_to "Profile", edit_user_registration_path, class: "block px-4 py-2 text-gray-800 hover:bg-indigo-100" %>
                <%= link_to "Settings", "#", class: "block px-4 py-2 text-gray-800 hover:bg-indigo-100" %>
                <div class="border-t border-gray-200"></div>
                <%= button_to "Sign Out", destroy_user_session_path, method: :delete, 
                              class: "w-full text-left px-4 py-2 text-gray-800 hover:bg-indigo-100" %>
              </div>
            </div>
          <% else %>
            <div class="flex space-x-2">
              <%= link_to "Sign In", new_user_session_path, class: "px-3 py-1 bg-indigo-600 text-white rounded hover:bg-indigo-700 text-sm" %>
              <%= link_to "Sign Up", new_user_registration_path, class: "px-3 py-1 bg-white text-indigo-900 rounded hover:bg-gray-100 text-sm" %>
            </div>
          <% end %>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow container mx-auto px-4 py-6">
      <div class="flex flex-col md:flex-row gap-6">
        <!-- Sidebar -->
        <aside class="w-full md:w-64 flex-shrink-0">
          <div class="bg-white rounded-lg shadow p-4 mb-6">
            <h3 class="font-bold text-lg mb-4">Quick Actions</h3>
            <ul class="space-y-2">
              <li>
                <a href="#" class="flex items-center space-x-2 text-indigo-700 hover:text-indigo-900">
                  <i class="fas fa-plus-circle"></i>
                  <span>New Release</span>
                </a>
              </li>
              <li>
                <a href="#" class="flex items-center space-x-2 text-gray-700 hover:text-indigo-900">
                  <i class="fas fa-tshirt"></i>
                  <span>Add Merch</span>
                </a>
              </li>
              <li>
                <a href="#" class="flex items-center space-x-2 text-gray-700 hover:text-indigo-900">
                  <i class="fas fa-chart-line"></i>
                  <span>View Stats</span>
                </a>
              </li>
              <li>
                <a href="#" class="flex items-center space-x-2 text-gray-700 hover:text-indigo-900">
                  <i class="fas fa-cog"></i>
                  <span>Settings</span>
                </a>
              </li>
            </ul>
          </div>

          <div class="bg-white rounded-lg shadow p-4">
            <h3 class="font-bold text-lg mb-4">Recent Activity</h3>
            <ul class="space-y-3">
              <li class="flex items-start space-x-2">
                <div class="text-green-500">
                  <i class="fas fa-shopping-cart"></i>
                </div>
                <div>
                  <p class="text-sm">New album purchase</p>
                  <p class="text-xs text-gray-500">"Summer Waves" by Sarah Fan</p>
                </div>
              </li>
              <li class="flex items-start space-x-2">
                <div class="text-blue-500">
                  <i class="fas fa-download"></i>
                </div>
                <div>
                  <p class="text-sm">Track download</p>
                  <p class="text-xs text-gray-500">"Midnight Drive" (320kbps)</p>
                </div>
              </li>
              <li class="flex items-start space-x-2">
                <div class="text-yellow-500">
                  <i class="fas fa-star"></i>
                </div>
                <div>
                  <p class="text-sm">New fan</p>
                  <p class="text-xs text-gray-500">Alex MusicLover followed you</p>
                </div>
              </li>
            </ul>
          </div>
        </aside>

        <!-- Main Dashboard -->
        <div class="flex-grow">
          <!-- Stats Summary -->
          <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
            <div class="bg-white rounded-lg shadow p-4">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-gray-500 text-sm">Total Earnings</p>
                  <p class="text-2xl font-bold">$1,245.80</p>
                </div>
                <div class="text-green-500 bg-green-100 p-3 rounded-full">
                  <i class="fas fa-wallet text-lg"></i>
                </div>
              </div>
              <p class="text-xs text-green-500 mt-2">+12.5% from last month</p>
            </div>
            <div class="bg-white rounded-lg shadow p-4">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-gray-500 text-sm">Album Sales</p>
                  <p class="text-2xl font-bold">328</p>
                </div>
                <div class="text-blue-500 bg-blue-100 p-3 rounded-full">
                  <i class="fas fa-compact-disc text-lg"></i>
                </div>
              </div>
              <p class="text-xs text-green-500 mt-2">+8.2% from last month</p>
            </div>
            <div class="bg-white rounded-lg shadow p-4">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-gray-500 text-sm">Track Downloads</p>
                  <p class="text-2xl font-bold">1,042</p>
                </div>
                <div class="text-purple-500 bg-purple-100 p-3 rounded-full">
                  <i class="fas fa-music text-lg"></i>
                </div>
              </div>
              <p class="text-xs text-green-500 mt-2">+5.7% from last month</p>
            </div>
            <div class="bg-white rounded-lg shadow p-4">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-gray-500 text-sm">New Fans</p>
                  <p class="text-2xl font-bold">156</p>
                </div>
                <div class="text-yellow-500 bg-yellow-100 p-3 rounded-full">
                  <i class="fas fa-users text-lg"></i>
                </div>
              </div>
              <p class="text-xs text-green-500 mt-2">+22.3% from last month</p>
            </div>
          </div>

          <!-- Albums Section -->
          <div class="bg-white rounded-lg shadow p-6 mb-6">
            <div class="flex justify-between items-center mb-6">
              <h2 class="text-2xl font-bold">Your Albums</h2>
              <button class="bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700 flex items-center space-x-2">
                <i class="fas fa-plus"></i>
                <span>Add New Album</span>
              </button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              <!-- Album Card 1 -->
              <div class="border rounded-lg overflow-hidden hover:shadow-lg transition">
                <div class="relative">
                  <img src="https://f4.bcbits.com/img/a1058450903_16.jpg" alt="Album Cover" class="w-full h-48 object-cover">
                  <div class="absolute bottom-2 right-2 bg-black bg-opacity-70 text-white px-2 py-1 rounded text-sm">
                    $8.00
                  </div>
                </div>
                <div class="p-4">
                  <h3 class="font-bold text-lg mb-1">Midnight Echoes</h3>
                  <p class="text-gray-600 text-sm mb-3">Released: June 2023</p>
                  <div class="flex justify-between items-center">
                    <div class="flex space-x-2">
                      <span class="bg-indigo-100 text-indigo-800 text-xs px-2 py-1 rounded">12 tracks</span>
                      <span class="bg-green-100 text-green-800 text-xs px-2 py-1 rounded">128 sales</span>
                    </div>
                    <div class="flex space-x-2">
                      <button class="text-gray-500 hover:text-indigo-600">
                        <i class="fas fa-edit"></i>
                      </button>
                      <button class="text-gray-500 hover:text-indigo-600">
                        <i class="fas fa-chart-line"></i>
                      </button>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Album Card 2 -->
              <div class="border rounded-lg overflow-hidden hover:shadow-lg transition">
                <div class="relative">
                  <img src="https://f4.bcbits.com/img/a4128039955_16.jpg" alt="Album Cover" class="w-full h-48 object-cover">
                  <div class="absolute bottom-2 right-2 bg-black bg-opacity-70 text-white px-2 py-1 rounded text-sm">
                    $10.00
                  </div>
                </div>
                <div class="p-4">
                  <h3 class="font-bold text-lg mb-1">Summer Waves</h3>
                  <p class="text-gray-600 text-sm mb-3">Released: August 2022</p>
                  <div class="flex justify-between items-center">
                    <div class="flex space-x-2">
                      <span class="bg-indigo-100 text-indigo-800 text-xs px-2 py-1 rounded">8 tracks</span>
                      <span class="bg-green-100 text-green-800 text-xs px-2 py-1 rounded">87 sales</span>
                    </div>
                    <div class="flex space-x-2">
                      <button class="text-gray-500 hover:text-indigo-600">
                        <i class="fas fa-edit"></i>
                      </button>
                      <button class="text-gray-500 hover:text-indigo-600">
                        <i class="fas fa-chart-line"></i>
                      </button>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Album Card 3 -->
              <div class="border rounded-lg overflow-hidden hover:shadow-lg transition">
                <div class="relative">
                  <img src="https://f4.bcbits.com/img/a0105518795_16.jpg" alt="Album Cover" class="w-full h-48 object-cover">
                  <div class="absolute bottom-2 right-2 bg-black bg-opacity-70 text-white px-2 py-1 rounded text-sm">
                    $5.00
                  </div>
                </div>
                <div class="p-4">
                  <h3 class="font-bold text-lg mb-1">Urban Dreams</h3>
                  <p class="text-gray-600 text-sm mb-3">Released: March 2021</p>
                  <div class="flex justify-between items-center">
                    <div class="flex space-x-2">
                      <span class="bg-indigo-100 text-indigo-800 text-xs px-2 py-1 rounded">6 tracks</span>
                      <span class="bg-green-100 text-green-800 text-xs px-2 py-1 rounded">113 sales</span>
                    </div>
                    <div class="flex space-x-2">
                      <button class="text-gray-500 hover:text-indigo-600">
                        <i class="fas fa-edit"></i>
                      </button>
                      <button class="text-gray-500 hover:text-indigo-600">
                        <i class="fas fa-chart-line"></i>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Recent Sales -->
          <div class="bg-white rounded-lg shadow p-6">
            <h2 class="text-2xl font-bold mb-6">Recent Sales</h2>
            <div class="overflow-x-auto">
              <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                  <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Item</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Buyer</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                  </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                  <tr>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">Today, 14:32</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">Midnight Echoes (Album)</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">michael.fan@email.com</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">$8.00</td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                        Completed
                      </span>
                    </td>
                  </tr>
                  <tr>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">Yesterday, 20:15</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">Summer Waves (Album)</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">sarah.music@email.com</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">$10.00</td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                        Completed
                      </span>
                    </td>
                  </tr>
                  <tr>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">Yesterday, 11:47</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">Midnight Drive (Track)</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">dj.alex@email.com</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">$1.50</td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">
                        Processing
                      </span>
                    </td>
                  </tr>
                  <tr>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">2 days ago, 09:22</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">Urban Dreams (Album)</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">music.lover@email.com</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">$5.00</td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                        Completed
                      </span>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</body>
</html>