<%# Dashboard Header %>
<div class="bg-music-surface shadow-genre border-b border-music-border">
  <div class="container mx-auto px-4 py-6">
    <h1 class="text-2xl font-bold font-display text-music-text">Dashboard</h1>
  </div>
</div>

<div class="min-h-screen bg-music-background">
  <div class="container mx-auto px-4 py-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">

      <%# Main Content %>
      <div class="md:col-span-3">
        <div class="bg-music-surface shadow-genre rounded-genre p-6 border border-music-border">
          <div class="flex justify-between items-center mb-6">
            <h2 class="text-xl font-semibold text-music-text">Your Releases</h2>
            <% if @releases.any? %>
              <%= link_to step1_release_wizard_index_path, class: "flex items-center gap-2 px-4 py-2 bg-music-primary text-music-text rounded-button hover:bg-opacity-80 transition-all duration-200 shadow-button" do %>
                <i class="fas fa-plus"></i> Create New Release
              <% end %>
            <% end %>
          </div>

          <% if @releases.any? %>
            <div class="overflow-x-auto">
              <table class="min-w-full divide-y divide-music-border">
                <thead class="bg-music-background">
                  <tr>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-music-text-secondary uppercase tracking-wider">Cover</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-music-text-secondary uppercase tracking-wider">Title</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-music-text-secondary uppercase tracking-wider">Artist</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-music-text-secondary uppercase tracking-wider">Type</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-music-text-secondary uppercase tracking-wider">Date</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-music-text-secondary uppercase tracking-wider">Price</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-music-text-secondary uppercase tracking-wider">Actions</th>
                  </tr>
                </thead>
                
                <tbody class="bg-music-surface divide-y divide-music-border">
                  <% @releases.each do |release| %>
                    <tr class="hover:bg-music-background transition-colors duration-200">
                      <td class="px-6 py-4 whitespace-nowrap">
                        <% if release.cover_art.attached? %>
                          <%= image_tag release.cover_art.variant(:thumb), class: "w-10 h-10 rounded-sm" %>
                        <% else %>
                          <div class="w-10 h-10 bg-music-background rounded-sm border border-music-border"></div>
                        <% end %>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm font-medium text-music-text"><%= release.title %></div>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm text-music-text-secondary"><%= release.artist %></div>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap">
                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-music-secondary bg-opacity-20 text-music-secondary border border-music-secondary border-opacity-30">
                          <%= release.release_type_human %>
                        </span>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap text-sm text-music-text-secondary">
                        <%= release.release_date.strftime("%Y-%m-%d") %>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap text-sm text-music-accent font-medium">
                        <%= number_to_currency(release.price) %>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                        <% if release.slug.present? && release.persisted? %>
                          <%= link_to "View", release_path(release), class: "text-music-secondary hover:text-music-primary mr-3 transition-colors" %>
                          <%= link_to "Edit", edit_release_path(release), class: "text-music-accent hover:text-music-primary mr-3 transition-colors" %>
                          <%= link_to "Delete", release_path(release), 
                              method: :delete, 
                              class: "text-music-primary hover:text-red-400 transition-colors",
                              data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
                        <% else %>
                          <span class="text-music-text-secondary text-sm">Draft - No actions available</span>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-12">
              <svg class="mx-auto h-12 w-12 text-music-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
              </svg>
              <h3 class="mt-2 text-sm font-medium text-music-text">No releases</h3>
              <p class="mt-1 text-sm text-music-text-secondary">Get started by creating a new release.</p>
              <div class="mt-6">
                <%= link_to step1_release_wizard_index_path, class: "inline-flex items-center px-4 py-2 border border-transparent shadow-button text-sm font-medium rounded-button text-music-text bg-music-primary hover:bg-opacity-80 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-music-primary transition-all duration-200" do %>
                  Create your first release
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <%# Sidebar %>
      <div class="md:col-span-1 space-y-6">
        <% if current_user.artist? %>
          <%# Followers Component %>
          <%= render 'followers' %>
        <% end %>
      </div>
    </div>
  </div>
</div>
