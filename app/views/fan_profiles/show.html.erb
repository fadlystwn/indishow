<%# Add required styles %>
<% content_for :head do %>
  <style>
    .genre-tag {
      transition: transform 0.2s;
      border-radius: 12px;
    }
    .genre-tag:hover {
      transform: scale(1.05);
    }
    .activity-card {
      transition: all 0.2s;
      border-radius: 12px;
      box-shadow: 0 4px 14px 0 rgba(0, 0, 0, 0.3);
    }
    .activity-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px 0 rgba(0, 0, 0, 0.4);
    }
    .follow-button {
      transition: all 0.2s;
      border-radius: 20px;
      box-shadow: 0 2px 10px 0 rgba(255, 77, 77, 0.4);
    }
    .follow-button:hover {
      transform: scale(1.05);
    }
    .line-clamp-2 {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  </style>
<% end %>

<%# Fan Header %>
<div class="bg-gradient-to-b from-music-background to-music-surface text-music-text">
  <%# Cover Image Section (optional for fans) %>
  <% if @fan_profile.avatar.attached? %>
    <div class="w-full h-48 md:h-64 overflow-hidden bg-gradient-to-r from-music-primary to-music-secondary">
      <!-- Could add a pattern or keep solid background -->
    </div>
  <% end %>

  <div class="container mx-auto px-4 py-12">
    <div class="flex flex-col md:flex-row items-center">
      <div class="w-32 h-32 md:w-48 md:h-48 rounded-full overflow-hidden border-4 border-music-accent shadow-lg mb-6 md:mb-0 md:mr-12">
        <% if @fan_profile.avatar.attached? %>
          <%= image_tag @fan_profile.avatar, class: "w-full h-full object-cover" %>
        <% else %>
          <div class="w-full h-full bg-music-surface flex items-center justify-center">
            <svg class="w-12 h-12 md:w-16 md:h-16 text-music-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
        <% end %>
      </div>

      <%# Profile details %>
      <div class="flex-1 text-center md:text-left">
        <h1 class="text-3xl md:text-4xl font-bold mb-2 font-display"><%= @fan_profile.name %></h1>
        <% if @fan_profile.location.present? %>
          <p class="text-music-text-secondary mb-4 flex items-center justify-center md:justify-start">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <%= @fan_profile.location %>
          </p>
        <% end %>
        
        <%# Favorite Genres %>
        <% if @fan_profile.favorite_genres.present? %>
          <div class="flex flex-wrap gap-2 justify-center md:justify-start mb-4">
            <% @fan_profile.favorite_genres.split(',').map(&:strip).each do |genre| %>
              <span class="genre-tag bg-music-primary bg-opacity-20 border border-music-primary px-3 py-1 rounded-genre text-sm text-music-text">
                <%= genre.titleize %>
              </span>
            <% end %>
          </div>
        <% end %>

        <%# Following Stats %>
        <div class="flex gap-4 justify-center md:justify-start mb-6">
          <span class="bg-music-surface border border-music-border px-3 py-1 rounded-genre text-sm text-music-text-secondary">
            Following <%= @fan_profile.user.following.count %> artists
          </span>
        </div>
        
        <div class="flex flex-col sm:flex-row gap-3 justify-center md:justify-start">
          <% if user_signed_in? && @fan_profile.user == current_user %>
            <%# Show Edit button for the fan %>
            <%= link_to edit_fan_profile_path(@fan_profile), class: "bg-music-surface hover:bg-opacity-80 border border-music-border text-music-text px-6 py-3 rounded-button font-medium flex items-center justify-center transition-all duration-200" do %>
              <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
              Edit Profile
            <% end %>
          <% else %>
            <%# Show Follow button for other users %>
            <button class="follow-button bg-music-secondary hover:bg-opacity-80 text-music-text px-6 py-3 rounded-button font-medium flex items-center justify-center transition-all duration-200">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" />
              </svg>
              Follow
            </button>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<%# Main Content %>
<main class="bg-music-background text-music-text min-h-screen">
  <div class="container mx-auto px-4 py-8" data-controller="tabs">
    <%# Fan Navigation %>
    <nav class="flex border-b border-music-border mb-8">
      <a href="#" data-tabs-target="tab" data-tab="activity" data-action="click->tabs#switchTab" class="px-4 py-3 font-medium text-music-primary border-b-2 border-music-primary">Activity</a>
      <a href="#" data-tabs-target="tab" data-tab="following" data-action="click->tabs#switchTab" class="px-4 py-3 font-medium text-music-text-secondary hover:text-music-primary transition-colors">Following</a>
      <a href="#" data-tabs-target="tab" data-tab="favorites" data-action="click->tabs#switchTab" class="px-4 py-3 font-medium text-music-text-secondary hover:text-music-primary transition-colors">Favorites</a>
      <a href="#" data-tabs-target="tab" data-tab="about" data-action="click->tabs#switchTab" class="px-4 py-3 font-medium text-music-text-secondary hover:text-music-primary transition-colors">About</a>
    </nav>

    <%# Activity Section %>
    <section data-tabs-target="content" data-content="activity" class="mb-12">
      <h2 class="text-2xl font-bold mb-6 font-display">Recent Activity</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <%# Placeholder activity cards - can be replaced with real data later %>
        <div class="activity-card bg-music-surface rounded-genre shadow-genre p-6 border border-music-border">
          <div class="flex items-center mb-4">
            <div class="w-12 h-12 rounded-full bg-music-primary bg-opacity-20 flex items-center justify-center mr-3">
              <svg class="w-6 h-6 text-music-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </div>
            <div>
              <p class="text-music-text font-medium">Liked a track</p>
              <p class="text-music-text-secondary text-sm">2 hours ago</p>
            </div>
          </div>
          <p class="text-music-text-secondary">"Amazing vocals on this new release!"</p>
        </div>

        <div class="activity-card bg-music-surface rounded-genre shadow-genre p-6 border border-music-border">
          <div class="flex items-center mb-4">
            <div class="w-12 h-12 rounded-full bg-music-secondary bg-opacity-20 flex items-center justify-center mr-3">
              <svg class="w-6 h-6 text-music-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
            </div>
            <div>
              <p class="text-music-text font-medium">Left a review</p>
              <p class="text-music-text-secondary text-sm">1 day ago</p>
            </div>
          </div>
          <p class="text-music-text-secondary">"This album perfectly captures the essence of indie rock!"</p>
        </div>

        <div class="activity-card bg-music-surface rounded-genre shadow-genre p-6 border border-music-border">
          <div class="flex items-center mb-4">
            <div class="w-12 h-12 rounded-full bg-music-accent bg-opacity-20 flex items-center justify-center mr-3">
              <svg class="w-6 h-6 text-music-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
              </svg>
            </div>
            <div>
              <p class="text-music-text font-medium">Followed an artist</p>
              <p class="text-music-text-secondary text-sm">3 days ago</p>
            </div>
          </div>
          <p class="text-music-text-secondary">Started following "The Midnight Sound"</p>
        </div>
      </div>
    </section>

    <%# Following Section %>
    <section data-tabs-target="content" data-content="following" class="mb-12 hidden">
      <h2 class="text-2xl font-bold mb-6 font-display">Following Artists</h2>
      <% if @fan_profile.user.followed_artists.any? %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          <% @fan_profile.user.followed_artists.includes(:profile, profile: { avatar_attachment: :blob }).each do |artist| %>
            <% artist_profile = artist.profile if artist.artist? %>
            <% if artist_profile %>
              <div class="bg-music-surface rounded-genre shadow-genre overflow-hidden hover:shadow-genre-hover transition-all duration-200 border border-music-border">
                <%= link_to artist_profile_path(artist_profile), class: "block" do %>
                  <%# Artist Avatar %>
                  <div class="aspect-square bg-music-background flex items-center justify-center">
                    <% if artist_profile.avatar.attached? %>
                      <%= image_tag artist_profile.avatar, class: "w-full h-full object-cover" %>
                    <% else %>
                      <svg class="w-16 h-16 text-music-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                      </svg>
                    <% end %>
                  </div>
                  
                  <%# Artist Info %>
                  <div class="p-4">
                    <h3 class="font-semibold text-music-text mb-1 truncate"><%= artist_profile.name %></h3>
                    <% if artist_profile.location.present? %>
                      <p class="text-music-text-secondary text-sm mb-2 flex items-center">
                        <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                        <%= artist_profile.location %>
                      </p>
                    <% end %>
                    
                    <%# Bio Preview %>
                    <% if artist_profile.bio.present? %>
                      <p class="text-music-text-secondary text-sm mt-2 line-clamp-2">
                        <%= truncate(artist_profile.bio, length: 80) %>
                      </p>
                    <% end %>
                  </div>
                <% end %>
                
                <%# Action Buttons %>
                <div class="p-4 pt-0">
                  <div class="flex gap-2">
                    <% if user_signed_in? && current_user == @fan_profile.user %>
                      <%= button_to unfollow_artist_profile_path(artist_profile), method: :delete,
                                    class: "flex-1 px-3 py-2 bg-music-background border border-music-border text-music-text-secondary rounded-button hover:bg-music-border transition-colors text-sm font-medium",
                                    data: { confirm: "Unfollow #{artist_profile.name}?" } do %>
                        Unfollow
                      <% end %>
                    <% end %>
                    <%= link_to artist_profile_path(artist_profile), class: "px-3 py-2 bg-music-primary text-music-text rounded-button hover:bg-opacity-80 transition-colors text-sm flex-1 text-center" do %>
                      View Profile
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <%# Empty State %>
        <div class="bg-music-surface rounded-genre shadow-genre p-12 border border-music-border text-center">
          <svg class="mx-auto h-16 w-16 text-music-text-secondary mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
          </svg>
          <h3 class="text-lg font-medium text-music-text mb-2">No Artists Followed Yet</h3>
          <p class="text-music-text-secondary mb-4">
            <% if user_signed_in? && current_user == @fan_profile.user %>
              Start discovering and following your favorite artists!
            <% else %>
              This fan hasn't followed any artists yet.
            <% end %>
          </p>
          <% if user_signed_in? && current_user == @fan_profile.user %>
            <%= link_to music_path, class: "inline-flex items-center px-4 py-2 bg-music-primary text-music-text rounded-button hover:bg-opacity-80 transition-colors font-medium" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              Discover Artists
            <% end %>
          <% end %>
        </div>
      <% end %>
    </section>

    <%# Favorites Section %>
    <section data-tabs-target="content" data-content="favorites" class="mb-12 hidden">
      <h2 class="text-2xl font-bold mb-6 font-display">Favorite Music</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        <%# Placeholder for favorite releases - can be replaced with real data later %>
        <div class="bg-music-surface rounded-genre shadow-genre overflow-hidden hover:shadow-genre-hover transition-all duration-200 border border-music-border">
          <div class="aspect-square bg-music-background flex items-center justify-center">
            <svg class="w-16 h-16 text-music-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
            </svg>
          </div>
          <div class="p-4">
            <h3 class="font-semibold text-music-text mb-1">Favorite Album</h3>
            <p class="text-music-text-secondary text-sm">Artist Name</p>
            <div class="flex items-center justify-between mt-3">
              <span class="text-music-text-secondary text-sm">2024</span>
              <button class="text-music-primary hover:text-music-primary/80 transition-colors">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <%# About Section %>
    <section data-tabs-target="content" data-content="about" class="mb-12 hidden">
      <h2 class="text-2xl font-bold mb-6 font-display">About</h2>
      <div class="bg-music-surface rounded-genre shadow-genre p-6 border border-music-border">
        <% if @fan_profile.bio.present? %>
          <div class="text-music-text mb-6">
            <%= simple_format @fan_profile.bio %>
          </div>
        <% else %>
          <div class="text-center py-8 text-music-text-secondary">
            <svg class="mx-auto h-12 w-12 text-music-text-secondary mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <p>No bio available yet.</p>
          </div>
        <% end %>

        <% if @fan_profile.website_url.present? %>
          <div class="mt-6 pt-6 border-t border-music-border">
            <%= link_to @fan_profile.website_url, target: "_blank", rel: "noopener", class: "inline-flex items-center text-music-primary hover:text-music-primary/80 transition-colors" do %>
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
              </svg>
              Visit Website
            <% end %>
          </div>
        <% end %>

        <% if @fan_profile.favorite_genres.present? %>
          <div class="mt-6 pt-6 border-t border-music-border">
            <h3 class="text-lg font-medium text-music-text mb-3">Music Tastes</h3>
            <div class="flex flex-wrap gap-2">
              <% @fan_profile.favorite_genres.split(',').map(&:strip).each do |genre| %>
                <span class="bg-music-background border border-music-border px-3 py-1 rounded-genre text-sm text-music-text-secondary">
                  #<%= genre.downcase.gsub(/\s+/, '') %>
                </span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  </div>
</main>
