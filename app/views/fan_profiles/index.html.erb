<%# Fan Discovery Page %>
<% content_for :head do %>
  <style>
    .line-clamp-2 {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  </style>
<% end %>

<div class="min-h-screen bg-music-background text-music-text">
  <div class="container mx-auto px-4 py-8">
    <%# Header %>
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold font-display mb-4">Discover Music Fans</h1>
      <p class="text-music-text-secondary text-lg">Connect with music enthusiasts who share your passion</p>
    </div>

    <%# Filters (future enhancement) %>
    <div class="bg-music-surface rounded-genre shadow-genre p-6 mb-8 border border-music-border">
      <div class="flex flex-wrap gap-4 items-center justify-between">
        <div class="flex flex-wrap gap-4">
          <button class="px-4 py-2 bg-music-primary text-music-text rounded-button hover:bg-opacity-80 transition-colors">
            All Fans
          </button>
          <button class="px-4 py-2 bg-music-surface border border-music-border text-music-text-secondary rounded-button hover:bg-music-border transition-colors">
            Rock Fans
          </button>
          <button class="px-4 py-2 bg-music-surface border border-music-border text-music-text-secondary rounded-button hover:bg-music-border transition-colors">
            Jazz Lovers
          </button>
          <button class="px-4 py-2 bg-music-surface border border-music-border text-music-text-secondary rounded-button hover:bg-music-border transition-colors">
            Electronic
          </button>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-music-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input type="text" placeholder="Search fans..." class="px-3 py-2 bg-music-background border border-music-border rounded-button text-music-text placeholder-music-text-secondary focus:outline-none focus:ring-2 focus:ring-music-primary">
        </div>
      </div>
    </div>

    <%# Fan Profiles Grid %>
    <% if @fan_profiles.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        <% @fan_profiles.each do |fan_profile| %>
          <div class="bg-music-surface rounded-genre shadow-genre overflow-hidden hover:shadow-genre-hover transition-all duration-200 border border-music-border">
            <%= link_to fan_profile_path(fan_profile), class: "block" do %>
              <%# Avatar %>
              <div class="aspect-square bg-music-background flex items-center justify-center">
                <% if fan_profile.avatar.attached? %>
                  <%= image_tag fan_profile.avatar, class: "w-full h-full object-cover" %>
                <% else %>
                  <svg class="w-16 h-16 text-music-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                <% end %>
              </div>
              
              <%# Profile Info %>
              <div class="p-4">
                <h3 class="font-semibold text-music-text mb-1 truncate"><%= fan_profile.name %></h3>
                <% if fan_profile.location.present? %>
                  <p class="text-music-text-secondary text-sm mb-2 flex items-center">
                    <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <%= fan_profile.location %>
                  </p>
                <% end %>
                
                <%# Favorite Genres %>
                <% if fan_profile.favorite_genres.present? %>
                  <div class="flex flex-wrap gap-1">
                    <% fan_profile.favorite_genres.split(',').map(&:strip).first(3).each do |genre| %>
                      <span class="px-2 py-1 bg-music-primary bg-opacity-20 text-music-primary text-xs rounded-genre">
                        <%= genre.titleize %>
                      </span>
                    <% end %>
                    <% if fan_profile.favorite_genres.split(',').size > 3 %>
                      <span class="px-2 py-1 bg-music-background text-music-text-secondary text-xs rounded-genre">
                        +<%= fan_profile.favorite_genres.split(',').size - 3 %>
                      </span>
                    <% end %>
                  </div>
                <% end %>
                
                <%# Bio Preview %>
                <% if fan_profile.bio.present? %>
                  <p class="text-music-text-secondary text-sm mt-2 line-clamp-2">
                    <%= truncate(fan_profile.bio, length: 80) %>
                  </p>
                <% end %>
              </div>
            <% end %>
            
            <%# Action Buttons %>
            <div class="p-4 pt-0">
              <div class="flex gap-2">
                <button class="flex-1 px-3 py-2 bg-music-primary text-music-text rounded-button hover:bg-opacity-80 transition-colors text-sm font-medium">
                  Follow
                </button>
                <%= link_to fan_profile_path(fan_profile), class: "px-3 py-2 bg-music-surface border border-music-border text-music-text-secondary rounded-button hover:bg-music-border transition-colors text-sm" do %>
                  View
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <%# Pagination %>
      <% if @fan_profiles.respond_to?(:current_page) && @fan_profiles.total_pages > 1 %>
        <div class="mt-12 flex justify-center">
          <%= paginate @fan_profiles %>
        </div>
      <% end %>
    <% else %>
      <%# Empty State %>
      <div class="text-center py-16">
        <svg class="mx-auto h-24 w-24 text-music-text-secondary mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        <h3 class="text-xl font-semibold text-music-text mb-2">No Fans Found</h3>
        <p class="text-music-text-secondary mb-6">Be the first music fan to create a profile!</p>
        <% if user_signed_in? && current_user.fan? %>
          <%= link_to "Create Your Fan Profile", edit_user_registration_path, 
                      class: "inline-flex items-center px-6 py-3 bg-music-primary text-music-text rounded-button hover:bg-opacity-80 transition-colors font-medium" %>
        <% else %>
          <%= link_to "Join as a Fan", new_user_registration_path, 
                      class: "inline-flex items-center px-6 py-3 bg-music-primary text-music-text rounded-button hover:bg-opacity-80 transition-colors font-medium" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
